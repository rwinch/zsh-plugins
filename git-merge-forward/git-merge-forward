#!/bin/zsh

# ---- options ----
dry_run=0                # --dry-run
do_pull=0                # --pull
allow_ahead=0            # --allow-ahead
ours=0                   # --ours
disclosures=0            # --disclosures
pause_after_merge=0      # --pause
releases_arg=""          # --releases V1,V2
releases_given=0
typeset -a branches      # positional args, in order

# ---- worktree map, rebuilt by build_worktree_map ----
typeset -a wt_branches   # parallel array: branch name at index i
typeset -a wt_paths      # parallel array: worktree path at index i

# ---- the merge plan: parallel arrays, one entry per hop ----
typeset -a hop_source
typeset -a hop_target
typeset -a hop_kind      # across | down
typeset -a hop_noop      # 1 when source is already contained in target
typeset -a hop_would     # 1 when the hop would (or might) change target

# ---- the release plan: parallel arrays, one entry per release ----
typeset -a rel_version
typeset -a rel_role      # frozen | active
typeset -a rel_gen       # <major>.<minor>
typeset -a rel_base      # disclosure branch the release is based on
typeset -a rel_note      # mapping note (main fallback)
typeset -a rel_will      # 1 when the release would be rewritten
typeset -a rel_lease     # sha of the remote release branch before rewriting

typeset -a all_branches  # every branch taking part, in plan order
typeset -A up_remote     # branch -> remote of its upstream
typeset -A up_branch     # branch -> branch name on that remote
typeset -a problems
typeset -A changed       # branch -> 1 when an earlier hop would change it
typeset -A rel_changed_flag

invoke_dir=""
original_ref=""
original_detached=0
chain_first=""
ab_behind=0
ab_ahead=0
nl=$'\n'

usage() {
	cat <<EOF
Usage: git-merge-forward [OPTIONS] BRANCH1 [BRANCH2 ...]
       git-merge-forward [OPTIONS] --disclosures GENERATION [GENERATION ...]
       git-merge-forward [OPTIONS] --releases VERSION[,VERSION ...]

Merge a chain of branches forward: BRANCH1 -> BRANCH2 -> ... Each branch is
merged in the worktree that has it checked out, or in the directory you run
from when it is not checked out anywhere (that directory is switched back to
its original branch at the end). The current branch has no special role: the
arguments are the whole chain.

Everything is validated before anything changes, and all problems are reported
together: every branch exists locally, has an upstream, and has a clean
worktree (untracked files count); then the remotes are fetched, and every
branch must match its upstream. The first branch may be ahead of its upstream
(that is what you merge forward), every other branch must be equal.
Nothing is pushed: the push commands are printed at the end.

OPTIONS:
  --dry-run, -n        Fetch, validate and print what would happen. Changes nothing.
  --pull, -p           Fast-forward every branch to its upstream first
  --allow-ahead, -a    Let any branch in the chain be ahead of its upstream (behind
                       and diverged still fail). Useful when resuming an aborted
                       run, and when several branches carry their own unpushed
                       commits.
  --ours, -o           Record across hops with 'git merge -s ours' (nothing is
                       carried, so no conflicts). Down hops stay real merges.
                       Use it when each branch has its own version/dependency
                       updates that must not merge across.
  --disclosures, -d    The arguments are OSS generation branches, oldest to newest
                       (7.0.x 7.1.x main). Merges across, then for frozen and
                       active each disclosure/<role>/<generation> branch down
                       (OSS -> frozen -> active) and across.
  --releases, -r LIST  Comma separated release versions to rebuild, e.g.
                       7.0.1,7.0.1.1,7.1.0-RC1. release/<version> becomes the
                       base disclosure branch plus the commits that are only on
                       the remote release branch (git rebase --onto). It needs a
                       force push, so the push command carries a lease. A hotfix
                       version (7.0.1.1) is based on disclosure/active/<major>.<minor>.x,
                       anything else on disclosure/frozen/<major>.<minor>.x. Use it
                       with a merge, or alone to update only the releases.
  --pause, -P          After each merge or release, stop so the result can be
                       validated, and say which directory to do it in
  --help, -h           Display this help message

VERSIONS (--releases):
  <major>.<minor>.<patch>, optionally followed by .<hotfix> or -RC<n> or -M<n>
  (RC and M need patch 0). A version whose <major>.<minor>.x disclosure branches
  do not exist maps to the 'main' disclosure branches, but only when it is the
  next generation after the newest existing one. At most one version per base
  branch (one hotfix and one non-hotfix per generation).

EXAMPLES:
  git-merge-forward 7.0.x 7.1.x main
  git-merge-forward --dry-run 7.0.x main
  git-merge-forward --pull 7.0.x main
  git-merge-forward --allow-ahead 7.0.x main        # resume after an abort
  git-merge-forward --disclosures 7.0.x main
  git-merge-forward --releases 7.0.1,7.0.1.1
  git-merge-forward --disclosures 7.0.x main --releases 7.0.1.1
  git-merge-forward -n -d 7.0.x main -r 7.0.1

DEPENDENCY UPDATES:
  If 7.0.x, 7.1.x and main each carry their own unpushed dependency updates
  that must not merge across, run:
    git-merge-forward --ours --allow-ahead --disclosures 7.0.x 7.1.x main
  Across hops (OSS and disclosure) are recorded with 'git merge -s ours', and the
  down hops into each disclosure branch are real merges, so every generation
  keeps its own updates. --allow-ahead is needed because 7.1.x and main are ahead
  of their upstreams; drop it if those updates are already pushed.

REQUIREMENTS:
  - Must be run from within a git repository
  - Every branch needs an upstream (git branch --set-upstream-to=<remote>/<b> <b>)
  - Every worktree touched must be clean (no untracked files either)

EOF
}

usage_error() {
	echo "Error: $1" >&2
	echo "Run 'git-merge-forward --help' for usage." >&2
	exit 1
}

# ---------------------------------------------------------------------------
# Problem collection
# ---------------------------------------------------------------------------
problem() {
	problems+=("$1")
}

print_problem() {
	local p="$1" first=1 l
	for l in "${(@f)p}"; do
		if (( first )); then
			echo "  - $l" >&2
			first=0
		else
			echo "      $l" >&2
		fi
	done
}

fail_if_problems() {
	[[ ${#problems[@]} -eq 0 ]] && return 0
	local p
	echo "Error: ${#problems[@]} problem(s) found. Nothing was merged:" >&2
	for p in "${problems[@]}"; do
		print_problem "$p"
	done
	exit 1
}

# ---------------------------------------------------------------------------
# Worktrees
# ---------------------------------------------------------------------------
build_worktree_map() {
	local current_path=""
	local line

	wt_branches=()
	wt_paths=()

	while IFS= read -r line; do
		case "$line" in
			"worktree "*)
				current_path="${line#worktree }"
				;;
			"branch "*)
				local ref="${line#branch }"
				wt_branches+=("${ref#refs/heads/}")
				wt_paths+=("$current_path")
				;;
			"")
				current_path=""
				;;
		esac
	done < <(git -C "$invoke_dir" worktree list --porcelain)
}

# Echoes the directory for a branch: its worktree if it is checked out
# somewhere, otherwise the directory the tool was run from.
resolve_dir_for_branch() {
	local branch="$1" i

	for (( i = 1; i <= ${#wt_branches[@]}; i++ )); do
		if [[ "${wt_branches[$i]}" == "$branch" ]]; then
			echo "${wt_paths[$i]}"
			return 0
		fi
	done
	echo "$invoke_dir"
}

is_branch_checked_out() {
	(( ${wt_branches[(Ie)$1]} ))
}

branch_exists() {
	git show-ref --verify --quiet "refs/heads/$1"
}

is_clean() {
	[[ -z "$(git -C "$1" status --porcelain)" ]]
}

# Echoes the name of an operation in progress in `dir` (merge, rebase, ...).
in_progress_state() {
	local dir="$1" gd f
	gd=$(git -C "$dir" rev-parse --absolute-git-dir 2>/dev/null) || return 1
	for f in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
		if [[ -e "$gd/$f" ]]; then
			case "$f" in
				MERGE_HEAD) echo "a merge is in progress (git -C \"$dir\" merge --abort, or commit it)" ;;
				CHERRY_PICK_HEAD) echo "a cherry-pick is in progress (git -C \"$dir\" cherry-pick --abort)" ;;
				REVERT_HEAD) echo "a revert is in progress (git -C \"$dir\" revert --abort)" ;;
				*) echo "a rebase is in progress (git -C \"$dir\" rebase --abort, or finish it)" ;;
			esac
			return 0
		fi
	done
	return 1
}

rebase_in_progress() {
	local gd
	gd=$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null) || return 1
	[[ -e "$gd/rebase-merge" || -e "$gd/rebase-apply" ]]
}

# Sets ab_behind/ab_ahead for `branch` against its upstream.
ahead_behind() {
	local branch="$1"
	local ref="refs/remotes/${up_remote[$branch]}/${up_branch[$branch]}"
	read ab_behind ab_ahead <<< "$(git rev-list --left-right --count "$ref...refs/heads/$branch")"
}

upstream_display() {
	echo "${up_remote[$1]}/${up_branch[$1]}"
}

add_branch() {
	(( ${all_branches[(Ie)$1]} )) || all_branches+=("$1")
}

# ---------------------------------------------------------------------------
# Plan
# ---------------------------------------------------------------------------
add_hop() {
	hop_source+=("$1")
	hop_target+=("$2")
	hop_kind+=("$3")
}

build_plan() {
	local i n
	if [[ $disclosures -eq 0 ]]; then
		for (( i = 2; i <= ${#branches[@]}; i++ )); do
			add_hop "${branches[$((i - 1))]}" "${branches[$i]}" across
		done
		return 0
	fi

	local -a gens
	gens=("${branches[@]}")
	n=${#gens[@]}
	local role
	for (( i = 2; i <= n; i++ )); do
		add_hop "${gens[$((i - 1))]}" "${gens[$i]}" across
	done
	for role in frozen active; do
		for (( i = 1; i <= n; i++ )); do
			if [[ "$role" == frozen ]]; then
				add_hop "${gens[$i]}" "disclosure/frozen/${gens[$i]}" down
			else
				add_hop "disclosure/frozen/${gens[$i]}" "disclosure/active/${gens[$i]}" down
			fi
			if (( i > 1 )); then
				add_hop "disclosure/$role/${gens[$((i - 1))]}" "disclosure/$role/${gens[$i]}" across
			fi
		done
	done
}

# Parses and checks --releases (no git needed).
parse_releases() {
	local -a items
	local v key
	local -A seen_version seen_base
	items=("${(@s:,:)releases_arg}")
	local major minor patch hotfix pre

	for v in "${items[@]}"; do
		if [[ ! "$v" =~ '^([0-9]+)\.([0-9]+)\.([0-9]+)(\.([0-9]+)|-(RC[0-9]+|M[0-9]+))?$' ]]; then
			usage_error "Invalid release version '$v' (expected <major>.<minor>.<patch>, optionally .<hotfix> or -RC<n> or -M<n>)"
		fi
		major="${match[1]}"; minor="${match[2]}"; patch="${match[3]}"; hotfix="${match[5]}"; pre="${match[6]}"
		if [[ -n "$pre" && "$patch" != 0 ]]; then
			usage_error "Invalid release version '$v' (an RC or M version must have patch 0)"
		fi
		if (( ${+seen_version[$v]} )); then
			usage_error "Release version '$v' is given more than once"
		fi
		seen_version[$v]=1
		local role=frozen
		[[ -n "$hotfix" ]] && role=active
		key="$role/$major.$minor"
		if (( ${+seen_base[$key]} )); then
			usage_error "Release versions '${seen_base[$key]}' and '$v' are both based on disclosure/$role/$major.$minor.x (at most one per base branch)"
		fi
		seen_base[$key]="$v"
		rel_version+=("$v")
		rel_role+=("$role")
		rel_gen+=("$major.$minor")
		rel_base+=("")
		rel_note+=("")
		rel_will+=(0)
		rel_lease+=("")
	done
}

# Maps every release to its base disclosure branch (needs the local branches).
map_release_bases() {
	local -a existing missing_gens
	local ref name i gen
	local -A exists_gen missing_versions

	while IFS= read -r ref; do
		if [[ "$ref" =~ '^disclosure/(frozen|active)/([0-9]+\.[0-9]+)\.x$' ]]; then
			exists_gen[${match[2]}]=1
		fi
	done < <(git for-each-ref --format='%(refname:short)' refs/heads/disclosure)

	for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
		gen="${rel_gen[$i]}"
		if (( ${+exists_gen[$gen]} )); then
			rel_base[$i]="disclosure/${rel_role[$i]}/$gen.x"
		else
			missing_versions[$gen]+="${missing_versions[$gen]:+, }${rel_version[$i]}"
			(( ${missing_gens[(Ie)$gen]} )) || missing_gens+=("$gen")
		fi
	done

	[[ ${#missing_gens[@]} -eq 0 ]] && return 0

	if [[ ${#exists_gen} -eq 0 ]]; then
		problem "No disclosure/*/<major>.<minor>.x branches exist locally, so releases ${(j:, :)${(v)missing_versions}} cannot be mapped"
		return 0
	fi

	local newest="" nmaj=-1 nmin=-1 g gmaj gmin
	for g in ${(k)exists_gen}; do
		gmaj=${g%%.*}; gmin=${g##*.}
		if (( gmaj > nmaj || (gmaj == nmaj && gmin > nmin) )); then
			nmaj=$gmaj; nmin=$gmin; newest="$g"
		fi
	done

	if [[ ${#missing_gens[@]} -gt 1 ]]; then
		for g in "${missing_gens[@]}"; do
			problem "Release(s) ${missing_versions[$g]}: no disclosure/*/$g.x branches, and several newer generations are given (${(j:, :)missing_gens}), so none can map to main"
		done
		return 0
	fi

	g="${missing_gens[1]}"
	local cand1="$nmaj.$((nmin + 1))" cand2="$((nmaj + 1)).0"
	if [[ "$g" != "$cand1" && "$g" != "$cand2" ]]; then
		problem "Release(s) ${missing_versions[$g]}: no disclosure/*/$g.x branches, and $g is not the generation after the newest existing one ($newest, next is $cand1 or $cand2), so it cannot map to main"
		return 0
	fi
	for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
		if [[ "${rel_gen[$i]}" == "$g" ]]; then
			rel_base[$i]="disclosure/${rel_role[$i]}/main"
			rel_note[$i]="no $g.x branch, newest generation"
		fi
	done
}

# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------
check_dir() {
	local dir="$1" label="$2" st state count
	st=$(git -C "$dir" status --porcelain)
	if [[ -n "$st" ]]; then
		count=${#${(f)st}}
		problem "$label: working tree not clean, $count change(s) ($dir)"
	fi
	if state=$(in_progress_state "$dir"); then
		problem "$label: $state"
	fi
}

# Everything that needs no network: branches exist, worktrees clean, upstreams set.
validate_local() {
	local b d r m
	local -A dir_label

	for b in "${all_branches[@]}"; do
		if ! branch_exists "$b"; then
			problem "$b: branch does not exist locally${nl}git branch $b <remote>/$b"
			continue
		fi
		d=$(resolve_dir_for_branch "$b")
		dir_label[$d]="${dir_label[$d]:+${dir_label[$d]}, }$b"

		r=$(git config "branch.$b.remote")
		m=$(git config "branch.$b.merge")
		if [[ -z "$r" || -z "$m" || "$r" == "." ]]; then
			problem "$b: no upstream${nl}git branch --set-upstream-to=<remote>/$b $b${nl}or: git push -u <remote> $b"
			continue
		fi
		up_remote[$b]="$r"
		up_branch[$b]="${m#refs/heads/}"
	done

	local i rb
	for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
		rb="release/${rel_version[$i]}"
		if branch_exists "$rb"; then
			d=$(resolve_dir_for_branch "$rb")
		else
			d="$invoke_dir"
		fi
		dir_label[$d]="${dir_label[$d]:+${dir_label[$d]}, }$rb"
	done

	for d in ${(k)dir_label}; do
		check_dir "$d" "${dir_label[$d]}"
	done
}

# After the fetch: upstream refs exist, release branches exist on the remote.
validate_remote_refs() {
	local b i rb rr base
	for b in "${all_branches[@]}"; do
		[[ -z "${up_remote[$b]}" ]] && continue
		if ! git show-ref --verify --quiet "refs/remotes/${up_remote[$b]}/${up_branch[$b]}"; then
			problem "$b: upstream '$(upstream_display $b)' no longer exists on the remote (gone)${nl}git branch --set-upstream-to=<remote>/$b $b${nl}or: git push -u <remote> $b"
		fi
	done

	for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
		rb="release/${rel_version[$i]}"
		base="${rel_base[$i]}"
		[[ -z "${up_remote[$base]}" ]] && continue
		rr="${up_remote[$base]}"
		if ! git show-ref --verify --quiet "refs/remotes/$rr/$rb"; then
			problem "$rb: does not exist on '$rr' (only existing release branches are updated)"
			continue
		fi
		if git rev-list --merges "refs/remotes/$rr/$rb" "^refs/remotes/${up_remote[$base]}/${up_branch[$base]}" | grep -q .; then
			problem "$rb: has merge commit(s) that are not on $(upstream_display $base), which a rebase would flatten:${nl}$(git rev-list --merges --oneline "refs/remotes/$rr/$rb" "^refs/remotes/${up_remote[$base]}/${up_branch[$base]}")"
		fi
		if branch_exists "$rb"; then
			local lsha rsha
			lsha=$(git rev-parse "refs/heads/$rb")
			rsha=$(git rev-parse "refs/remotes/$rr/$rb")
			if [[ "$lsha" != "$rsha" ]]; then
				if [[ $do_pull -eq 1 ]] && git merge-base --is-ancestor "$lsha" "$rsha"; then
					: # behind only, --pull fast-forwards it
				else
					problem "$rb: local branch differs from $rr/$rb (use --pull if it is only behind, otherwise reset or delete the local branch)"
				fi
			fi
		fi
	done
}

# Fast-forwards every branch that is only behind its upstream.
pull_branches() {
	local b i rb dir rr ref
	for b in "${all_branches[@]}"; do
		[[ -z "${up_remote[$b]}" ]] && continue
		ahead_behind "$b"
		if [[ "$ab_behind" -gt 0 && "$ab_ahead" -eq 0 ]]; then
			ref="refs/remotes/${up_remote[$b]}/${up_branch[$b]}"
			echo "Pulling '$b' ($ab_behind commit(s)) from $(upstream_display $b)"
			if is_branch_checked_out "$b"; then
				dir=$(resolve_dir_for_branch "$b")
				if ! git -C "$dir" merge --ff-only "$ref" > /dev/null 2>&1; then
					echo "Error: cannot fast-forward '$b' to $(upstream_display $b) (dir: $dir)" >&2
					exit 1
				fi
			else
				if ! git fetch . "${ref}:refs/heads/${b}"; then
					echo "Error: cannot fast-forward '$b' to $(upstream_display $b)" >&2
					exit 1
				fi
			fi
		fi
	done

	for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
		rb="release/${rel_version[$i]}"
		branch_exists "$rb" || continue
		rr="${up_remote[${rel_base[$i]}]}"
		ref="refs/remotes/$rr/$rb"
		[[ "$(git rev-parse refs/heads/$rb)" == "$(git rev-parse $ref)" ]] && continue
		echo "Pulling '$rb' from $rr/$rb"
		if is_branch_checked_out "$rb"; then
			dir=$(resolve_dir_for_branch "$rb")
			git -C "$dir" merge --ff-only "$ref" > /dev/null 2>&1 || { echo "Error: cannot fast-forward '$rb' to $rr/$rb (dir: $dir)" >&2; exit 1; }
		else
			git fetch . "${ref}:refs/heads/${rb}" > /dev/null 2>&1 || { echo "Error: cannot fast-forward '$rb' to $rr/$rb" >&2; exit 1; }
		fi
	done
}

# Every branch must match its upstream (the first may be ahead).
check_up_to_date() {
	local b allowed unpushed
	for b in "${all_branches[@]}"; do
		[[ -z "${up_remote[$b]}" ]] && continue
		git show-ref --verify --quiet "refs/remotes/${up_remote[$b]}/${up_branch[$b]}" || continue
		ahead_behind "$b"
		[[ "$ab_behind" -eq 0 && "$ab_ahead" -eq 0 ]] && continue

		if [[ "$ab_behind" -gt 0 && "$ab_ahead" -gt 0 ]]; then
			problem "$b: diverged from $(upstream_display $b) ($ab_ahead ahead, $ab_behind behind), rebase or merge $(upstream_display $b) first"
		elif [[ "$ab_behind" -gt 0 ]]; then
			problem "$b: behind $(upstream_display $b) by $ab_behind commit(s) (use --pull)"
		else
			allowed=0
			[[ "$b" == "$chain_first" || $allow_ahead -eq 1 ]] && allowed=1
			if [[ $allowed -eq 0 ]]; then
				unpushed=$(git log --oneline -5 "refs/remotes/${up_remote[$b]}/${up_branch[$b]}..refs/heads/$b")
				problem "$b: ahead of $(upstream_display $b) by $ab_ahead commit(s), only the first branch may be ahead (see --allow-ahead)${nl}${unpushed}"
			fi
		fi
	done
}

# ---------------------------------------------------------------------------
# Plan evaluation and printing
# ---------------------------------------------------------------------------
evaluate_plan() {
	local i b
	changed=()
	for (( i = 1; i <= ${#hop_source[@]}; i++ )); do
		if git merge-base --is-ancestor "refs/heads/${hop_source[$i]}" "refs/heads/${hop_target[$i]}"; then
			hop_noop[$i]=1
		else
			hop_noop[$i]=0
		fi
		if [[ "${hop_noop[$i]}" -eq 0 || -n "${changed[${hop_source[$i]}]}" ]]; then
			hop_would[$i]=1
			changed[${hop_target[$i]}]=1
		else
			hop_would[$i]=0
		fi
	done

	local rr base rb
	for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
		base="${rel_base[$i]}"
		rb="release/${rel_version[$i]}"
		rr="${up_remote[$base]}"
		if git merge-base --is-ancestor "refs/heads/$base" "refs/remotes/$rr/$rb" && [[ -z "${changed[$base]}" ]]; then
			rel_will[$i]=0
		else
			rel_will[$i]=1
		fi
	done
}

everything_noop() {
	local i
	for (( i = 1; i <= ${#hop_source[@]}; i++ )); do
		[[ "${hop_noop[$i]}" -eq 0 ]] && return 1
	done
	for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
		[[ "${rel_will[$i]}" -eq 1 ]] && return 1
	done
	return 0
}

print_plan() {
	local i ws=0 wt=0 wk=6 mode hop_status dir
	for (( i = 1; i <= ${#hop_source[@]}; i++ )); do
		(( ${#hop_source[$i]} > ws )) && ws=${#hop_source[$i]}
		(( ${#hop_target[$i]} > wt )) && wt=${#hop_target[$i]}
	done

	if (( ${#hop_source[@]} > 0 )); then
		echo "Plan:"
		for (( i = 1; i <= ${#hop_source[@]}; i++ )); do
			mode=merge
			[[ $ours -eq 1 && "${hop_kind[$i]}" == across ]] && mode=ours
			if [[ "${hop_would[$i]}" -eq 1 ]]; then hop_status="would merge"; else hop_status="up to date"; fi
			dir=$(resolve_dir_for_branch "${hop_target[$i]}")
			printf '  (%d) %-*s -> %-*s  %-*s %-5s %s\n' "$i" "$ws" "${hop_source[$i]}" "$wt" "${hop_target[$i]}" "$wk" "${hop_kind[$i]}" "$mode" "$hop_status"
			printf '        dir: %s   upstream: %s\n' "$dir" "$(upstream_display "${hop_target[$i]}")"
		done
	fi

	if (( ${#rel_version[@]} > 0 )); then
		echo "Releases:"
		local count rr base rb
		for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
			base="${rel_base[$i]}"
			rb="release/${rel_version[$i]}"
			rr="${up_remote[$base]}"
			if [[ "${rel_will[$i]}" -eq 1 ]]; then
				count=$(git rev-list --count "refs/remotes/$rr/$rb" "^refs/remotes/$rr/${up_branch[$base]}")
				echo "  $rb on $base: would rebase $count commit(s) [$rr]"
			else
				echo "  $rb on $base: up to date [$rr]"
			fi
			[[ -n "${rel_note[$i]}" ]] && echo "        (${rel_note[$i]})"
		done
	fi
}

# One 'git push --atomic' per remote, remotes in plan order.
print_push_commands() {
	local -a remotes refs
	local b r i rb rr
	for b in "${all_branches[@]}"; do
		r="${up_remote[$b]}"
		(( ${remotes[(Ie)$r]} )) || remotes+=("$r")
	done

	for r in "${remotes[@]}"; do
		refs=()
		for b in "${all_branches[@]}"; do
			[[ "${up_remote[$b]}" == "$r" ]] || continue
			if [[ "$b" == "${up_branch[$b]}" ]]; then
				refs+=("$b")
			else
				refs+=("${b}:${up_branch[$b]}")
			fi
		done
		for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
			[[ "${rel_will[$i]}" -eq 1 ]] || continue
			[[ "${up_remote[${rel_base[$i]}]}" == "$r" ]] || continue
			rb="release/${rel_version[$i]}"
			refs+=("+$rb")
		done
		for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
			[[ "${rel_will[$i]}" -eq 1 ]] || continue
			[[ "${up_remote[${rel_base[$i]}]}" == "$r" ]] || continue
			rb="release/${rel_version[$i]}"
			refs+=("--force-with-lease=${rb}:${rel_lease[$i]}")
		done
		print -r -- "  git push --atomic $r \\"
		print -r -- "    ${refs[*]}"
	done
}

# ---------------------------------------------------------------------------
# Interactive helpers
# ---------------------------------------------------------------------------
read_tty() {
	local dir="$1"
	local response
	if ! read -r response </dev/tty; then
		echo "Error: No terminal available to prompt for input (dir: $dir)" >&2
		exit 1
	fi
	REPLY_TTY="$response"
}

prompt_retry() {
	local dir="$1"
	echo ""
	echo "Fix it in $dir, then:"
	echo "[Enter=retry / Ctrl+C=abort]"
	read_tty "$dir"
}

handle_conflict() {
	local dir="$1" source="$2" target="$3"

	echo ""
	echo "✗ Merge conflict merging '$source' into '$target'"
	echo ""
	echo "Resolve conflicts in: $dir"
	echo "Then run:"
	echo "  git -C \"$dir\" add <conflicted files>   (or: git -C \"$dir\" add -A)"
	echo "  git -C \"$dir\" commit --no-edit"
	echo ""

	while true; do
		echo "Resolved? [Enter=resume / f=force continue / Ctrl+C=abort]"
		read_tty "$dir"

		if [[ "$REPLY_TTY" == "f" || "$REPLY_TTY" == "F" ]]; then
			echo "⚠️  Force-continuing without validation..."
			return 0
		fi

		typeset -a conflict_problems
		conflict_problems=()

		if git -C "$dir" rev-parse -q --verify MERGE_HEAD > /dev/null 2>&1; then
			conflict_problems+=("MERGE_HEAD still present -- merge was not committed")
		fi

		local unmerged
		unmerged=$(git -C "$dir" diff --name-only --diff-filter=U)
		if [[ -n "$unmerged" ]]; then
			conflict_problems+=("Unmerged paths remain:")
			conflict_problems+=("${(f)unmerged}")
		fi

		if ! is_clean "$dir"; then
			conflict_problems+=("Working tree is not clean (uncommitted changes present)")
		fi

		if [[ ${#conflict_problems[@]} -eq 0 ]]; then
			echo "✓ Merge conflict resolved"
			return 0
		fi

		echo ""
		echo "Still not resolved:"
		local p
		for p in "${conflict_problems[@]}"; do
			echo "  - $p"
		done
		echo ""
	done
}

handle_rebase_conflict() {
	local dir="$1" branch="$2" base="$3"

	echo ""
	echo "✗ Rebase of '$branch' onto '$base' stopped"
	echo ""
	echo "Resolve conflicts in: $dir"
	echo "Then run:"
	echo "  git -C \"$dir\" add <conflicted files>   (or: git -C \"$dir\" add -A)"
	echo "  git -C \"$dir\" rebase --continue"
	echo ""

	while true; do
		echo "Resolved? [Enter=resume / Ctrl+C=abort]"
		read_tty "$dir"
		if rebase_in_progress "$dir"; then
			echo ""
			echo "Still not resolved: a rebase is still in progress in $dir"
			echo ""
			continue
		fi
		echo "✓ Rebase finished"
		return 0
	done
}

pause_for_validation() {
	local dir="$1" what="$2"

	echo ""
	echo "⏸  Paused after $what."
	echo "You can validate the result (e.g. build and run the tests) in: $dir"
	echo "[Enter=continue / Ctrl+C=abort]"
	read_tty "$dir"
}

# ---------------------------------------------------------------------------
# Merging
# ---------------------------------------------------------------------------
merge_branch() {
	local source="$1" target="$2" kind="$3"
	local dir current rc
	local -a cmd

	while true; do
		build_worktree_map
		dir=$(resolve_dir_for_branch "$target")

		echo ""
		echo "Merging '$source' -> '$target' (dir: $dir)"

		current=$(git -C "$dir" rev-parse --abbrev-ref HEAD)
		if [[ "$current" != "$target" ]]; then
			echo "  → Checking out '$target' in $dir"
			if ! git -C "$dir" checkout "$target" > /dev/null; then
				echo "✗ Failed to check out '$target' in $dir" >&2
				prompt_retry "$dir"
				continue
			fi
		fi

		if [[ $ours -eq 1 && "$kind" == across ]]; then
			cmd=(git -C "$dir" merge -s ours --no-ff -m "merge(ours): $source into $target" "$source")
		else
			cmd=(git -C "$dir" merge --no-edit "$source")
		fi

		"${cmd[@]}"
		rc=$?

		if git -C "$dir" rev-parse -q --verify MERGE_HEAD > /dev/null 2>&1; then
			handle_conflict "$dir" "$source" "$target"
			break
		fi
		if [[ $rc -ne 0 ]]; then
			echo "✗ Merge of '$source' into '$target' failed (not a conflict)" >&2
			prompt_retry "$dir"
			continue
		fi
		break
	done

	echo "✓ Merged '$source' into '$target' (dir: $dir)"

	if [[ $pause_after_merge -eq 1 ]]; then
		pause_for_validation "$dir" "merging '$source' into '$target'"
	fi
}

update_release() {
	local i="$1"
	local rb="release/${rel_version[$i]}" base="${rel_base[$i]}"
	local rr="${up_remote[$base]}"
	local rref="refs/remotes/$rr/$rb"
	local bref="refs/remotes/$rr/${up_branch[$base]}"
	local dir current rc

	echo ""
	if git merge-base --is-ancestor "refs/heads/$base" "$rref"; then
		echo "✓ '$rb' already contains '$base'"
		rel_will[$i]=0
		return 0
	fi
	rel_will[$i]=1
	rel_lease[$i]=$(git rev-parse "$rref")

	if ! branch_exists "$rb"; then
		echo "Creating local branch '$rb' from '$rr/$rb'"
		if ! git branch --track "$rb" "$rref" > /dev/null 2>&1; then
			echo "Error: cannot create local branch '$rb' from '$rr/$rb'" >&2
			exit 1
		fi
	fi

	while true; do
		build_worktree_map
		dir=$(resolve_dir_for_branch "$rb")
		echo "Rebuilding '$rb' on '$base' (dir: $dir)"

		git -C "$dir" rebase --onto "refs/heads/$base" "$bref" "$rb"
		rc=$?

		if rebase_in_progress "$dir"; then
			handle_rebase_conflict "$dir" "$rb" "$base"
		elif [[ $rc -ne 0 ]]; then
			echo "✗ Rebase of '$rb' onto '$base' failed (not a conflict)" >&2
			prompt_retry "$dir"
			continue
		fi

		if ! git merge-base --is-ancestor "refs/heads/$base" "refs/heads/$rb"; then
			echo "✗ '$rb' does not contain '$base' yet (was the rebase aborted?)" >&2
			prompt_retry "$dir"
			continue
		fi
		break
	done

	echo "✓ Rebuilt '$rb' on '$base' (dir: $dir)"

	if [[ $pause_after_merge -eq 1 ]]; then
		pause_for_validation "$dir" "rebuilding '$rb' on '$base'"
	fi
}

on_abort() {
	echo "" >&2
	echo "Aborted. The directory $invoke_dir was started on '$original_ref' (not restored)." >&2
	exit 130
}

restore_original_branch() {
	local current
	current=$(git -C "$invoke_dir" rev-parse --abbrev-ref HEAD)
	if [[ $original_detached -eq 1 ]]; then
		[[ "$(git -C "$invoke_dir" rev-parse HEAD)" == "$original_ref" ]] && return 0
		git -C "$invoke_dir" checkout --detach --quiet "$original_ref" || echo "⚠️  Could not restore $invoke_dir to $original_ref" >&2
	else
		[[ "$current" == "$original_ref" ]] && return 0
		if git -C "$invoke_dir" checkout --quiet "$original_ref"; then
			echo "Restored '$original_ref' in $invoke_dir"
		else
			echo "⚠️  Could not restore '$original_ref' in $invoke_dir" >&2
		fi
	fi
}

# ---------------------------------------------------------------------------
# Parse arguments
# ---------------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
	case $1 in
		--dry-run|-n) dry_run=1; shift ;;
		--pull|-p) do_pull=1; shift ;;
		--allow-ahead|-a) allow_ahead=1; shift ;;
		--ours|-o) ours=1; shift ;;
		--disclosures|-d) disclosures=1; shift ;;
		--pause|-P) pause_after_merge=1; shift ;;
		--releases|-r)
			if [[ -z "$2" || "$2" == -* ]]; then
				usage_error "$1 requires a value (e.g. 7.0.1,7.0.1.1)"
			fi
			releases_arg="$2"
			releases_given=1
			shift 2
			;;
		--help|-h) usage; exit 0 ;;
		-*) usage_error "Unknown option: $1" ;;
		*) branches+=("$1"); shift ;;
	esac
done

# ---------------------------------------------------------------------------
# Argument checks (no git yet)
# ---------------------------------------------------------------------------
if [[ $dry_run -eq 1 && $do_pull -eq 1 ]]; then
	usage_error "--dry-run cannot be combined with --pull"
fi

if [[ $disclosures -eq 1 ]]; then
	[[ ${#branches[@]} -ge 1 ]] || usage_error "--disclosures needs at least one generation branch"
elif [[ ${#branches[@]} -eq 0 ]]; then
	[[ $releases_given -eq 1 ]] || usage_error "At least two branches are required (or use --disclosures, or --releases alone)"
elif [[ ${#branches[@]} -eq 1 ]]; then
	usage_error "At least two branches are required (a single branch needs --disclosures)"
fi

typeset -A seen_arg
for b in "${branches[@]}"; do
	if (( ${+seen_arg[$b]} )); then
		usage_error "Branch '$b' is given more than once"
	fi
	seen_arg[$b]=1
done

[[ $releases_given -eq 1 ]] && parse_releases

if ! git rev-parse --git-dir > /dev/null 2>&1; then
	echo "Error: Not in a git repository" >&2
	exit 1
fi

# ---------------------------------------------------------------------------
# Main flow
# ---------------------------------------------------------------------------
invoke_dir=$(git rev-parse --show-toplevel 2>/dev/null)
if [[ -z "$invoke_dir" ]]; then
	echo "Error: Must be run from a worktree (not a bare repository)" >&2
	exit 1
fi
original_ref=$(git -C "$invoke_dir" rev-parse --abbrev-ref HEAD)
if [[ "$original_ref" == "HEAD" ]]; then
	original_detached=1
	original_ref=$(git -C "$invoke_dir" rev-parse HEAD)
fi

build_worktree_map

build_plan
for (( i = 1; i <= ${#hop_source[@]}; i++ )); do
	add_branch "${hop_source[$i]}"
	add_branch "${hop_target[$i]}"
done
[[ ${#branches[@]} -gt 0 ]] && chain_first="${branches[1]}"

if [[ $releases_given -eq 1 ]]; then
	map_release_bases
	for (( i = 1; i <= ${#rel_base[@]}; i++ )); do
		[[ -n "${rel_base[$i]}" ]] && add_branch "${rel_base[$i]}"
	done
fi

# 1. Local validation: exist, upstream, clean.
validate_local
fail_if_problems

# 2. Fetch every remote involved (also on a dry run).
typeset -a fetch_remotes
for b in "${all_branches[@]}"; do
	(( ${fetch_remotes[(Ie)${up_remote[$b]}]} )) || fetch_remotes+=("${up_remote[$b]}")
done
for r in "${fetch_remotes[@]}"; do
	echo "Fetching '$r'..."
	if ! git fetch "$r"; then
		echo "Error: Failed to fetch from remote '$r'" >&2
		exit 1
	fi
done
echo ""

validate_remote_refs
fail_if_problems

# 3. --pull, then every branch must match its upstream.
[[ $do_pull -eq 1 ]] && pull_branches
check_up_to_date
fail_if_problems

# 4. Nothing to do?
evaluate_plan
if everything_noop; then
	echo "Everything is up to date, nothing to merge."
	exit 0
fi

print_plan

if [[ $dry_run -eq 1 ]]; then
	echo ""
	echo "Dry run: nothing was changed. At the end it would print:"
	print_push_commands
	exit 0
fi

# 5. Merge, then rebuild the releases.
trap on_abort INT
echo ""
echo "Starting: ${#hop_source[@]} merge(s), ${#rel_version[@]} release(s)"

for (( i = 1; i <= ${#hop_source[@]}; i++ )); do
	merge_branch "${hop_source[$i]}" "${hop_target[$i]}" "${hop_kind[$i]}"
done

for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
	update_release "$i"
done
trap - INT

# 6. Finish.
echo ""
built=0
for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
	[[ "${rel_will[$i]}" -eq 1 ]] && (( built++ ))
done
echo "Done! Merged ${#hop_source[@]} hop(s), updated $built release(s)."
build_worktree_map
restore_original_branch

echo ""
echo "Nothing has been pushed. To publish, run:"
print_push_commands
