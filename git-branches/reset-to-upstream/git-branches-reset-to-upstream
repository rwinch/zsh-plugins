#!/bin/zsh

# ---- options ----
dry_run=0                # --dry-run
disclosures=0            # --disclosures
releases_arg=""          # --releases V1,V2
releases_given=0
typeset -a args          # positional args, in order
typeset -a release_branches

typeset -a wt_branches   # parallel array: branch name at index i
typeset -a wt_paths      # parallel array: worktree path at index i
typeset -a all_branches  # every branch to reset, in order
typeset -A up_remote     # branch -> remote of its upstream
typeset -A up_branch     # branch -> branch name on that remote
typeset -A b_state       # branch -> uptodate | behind | ahead | diverged
typeset -A b_count       # branch -> number of commits behind, or of local commits to discard
typeset -a problems

invoke_dir=""
ab_behind=0
ab_ahead=0
nl=$'\n'

usage() {
	cat <<EOF
Usage: git-branches-reset-to-upstream [OPTIONS] BRANCH1 [BRANCH2 ...]
       git-branches-reset-to-upstream [OPTIONS] --disclosures GENERATION [GENERATION ...]
       git-branches-reset-to-upstream [OPTIONS] --releases VERSION[,VERSION ...]

Hard reset every given branch to its remote tracked (upstream) branch as of the
last fetch (nothing is fetched: run git-branches-fetch first). A branch checked out in a worktree is reset in that worktree, any
other branch is moved with 'git branch -f'. Local commits are discarded; their
SHAs are printed at the end so they can be recovered.

Everything is validated before anything changes, and all problems are reported
together: every branch exists locally, has an upstream, and its worktree (if
any) is clean (untracked files count). Nothing is pushed.

OPTIONS:
  --dry-run, -n        Validate and print what would happen. Nothing is reset.
  --disclosures, -d    The arguments are OSS generation branches (7.0.x 7.1.x main).
                       Each is reset together with disclosure/frozen/<generation>
                       and disclosure/active/<generation>.
  --releases, -r LIST  Comma separated release versions, e.g. 7.0.1,7.0.1.1,7.1.0-RC1.
                       release/<version> is reset. Can be combined with the above.
  --help, -h           Display this help message

EXAMPLES:
  git-branches-reset-to-upstream 7.0.x main
  git-branches-reset-to-upstream --dry-run --disclosures 7.0.x 7.1.x main
  git-branches-reset-to-upstream -d 7.0.x main -r 7.0.1.1
  git-branches-reset-to-upstream \$(svaob) --releases \$(ghmr)   # OSS branches, this month's OSS and next month's hotfix releases

REQUIREMENTS:
  - Must be run from within a git repository
  - Every branch needs an upstream (git branch --set-upstream-to=<remote>/<b> <b>)
  - Every worktree touched must be clean (no untracked files either)

EOF
}

usage_error() {
	echo "Error: $1" >&2
	echo "Run 'git-branches-reset-to-upstream --help' for usage." >&2
	exit 1
}

problem() {
	problems+=("$1")
}

fail_if_problems() {
	[[ ${#problems[@]} -eq 0 ]] && return 0
	local p first l
	echo "Error: ${#problems[@]} problem(s) found. Nothing was reset:" >&2
	for p in "${problems[@]}"; do
		first=1
		for l in "${(@f)p}"; do
			if (( first )); then
				echo "  - $l" >&2
				first=0
			else
				echo "      $l" >&2
			fi
		done
	done
	exit 1
}

build_worktree_map() {
	local current_path="" line ref
	wt_branches=()
	wt_paths=()
	while IFS= read -r line; do
		case "$line" in
			"worktree "*) current_path="${line#worktree }" ;;
			"branch "*)
				ref="${line#branch }"
				wt_branches+=("${ref#refs/heads/}")
				wt_paths+=("$current_path")
				;;
			"") current_path="" ;;
		esac
	done < <(git -C "$invoke_dir" worktree list --porcelain)
}

# Echoes the worktree where a branch is checked out, nothing when it is not.
worktree_for_branch() {
	local i
	for (( i = 1; i <= ${#wt_branches[@]}; i++ )); do
		if [[ "${wt_branches[$i]}" == "$1" ]]; then
			echo "${wt_paths[$i]}"
			return 0
		fi
	done
	return 1
}

branch_exists() {
	git show-ref --verify --quiet "refs/heads/$1"
}

upstream_display() {
	echo "${up_remote[$1]}/${up_branch[$1]}"
}

# Echoes a message when a merge, cherry-pick, revert or rebase is in progress in `dir`.
in_progress_state() {
	local dir="$1" gd f
	gd=$(git -C "$dir" rev-parse --absolute-git-dir 2>/dev/null) || return 1
	for f in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
		if [[ -e "$gd/$f" ]]; then
			echo "a merge, cherry-pick, revert or rebase is in progress, abort or finish it first"
			return 0
		fi
	done
	return 1
}

add_branch() {
	(( ${all_branches[(Ie)$1]} )) || all_branches+=("$1")
}

parse_releases() {
	local -a items
	local v patch pre
	local -A seen
	items=("${(@s:,:)releases_arg}")
	for v in "${items[@]}"; do
		if [[ ! "$v" =~ '^([0-9]+)\.([0-9]+)\.([0-9]+)(\.([0-9]+)|-(RC[0-9]+|M[0-9]+))?$' ]]; then
			usage_error "Invalid release version '$v' (expected <major>.<minor>.<patch>, optionally .<hotfix> or -RC<n> or -M<n>)"
		fi
		patch="${match[3]}"; pre="${match[6]}"
		if [[ -n "$pre" && "$patch" != 0 ]]; then
			usage_error "Invalid release version '$v' (an RC or M version must have patch 0)"
		fi
		if (( ${+seen[$v]} )); then
			usage_error "Release version '$v' is given more than once"
		fi
		seen[$v]=1
		release_branches+=("release/$v")
	done
}

# Branches exist, upstreams are set, worktrees are clean.
validate_local() {
	local b d r m st
	for b in "${all_branches[@]}"; do
		if ! branch_exists "$b"; then
			problem "$b: branch does not exist locally${nl}git branch --track $b <remote>/$b"
			continue
		fi
		r=$(git config "branch.$b.remote")
		m=$(git config "branch.$b.merge")
		if [[ -z "$r" || -z "$m" || "$r" == "." ]]; then
			problem "$b: no upstream${nl}git branch --set-upstream-to=<remote>/$b $b"
			continue
		fi
		up_remote[$b]="$r"
		up_branch[$b]="${m#refs/heads/}"
		if d=$(worktree_for_branch "$b"); then
			st=$(git -C "$d" status --porcelain)
			if [[ -n "$st" ]]; then
				problem "$b: working tree not clean, ${#${(f)st}} change(s) ($d)"
			fi
			if st=$(in_progress_state "$d"); then
				problem "$b: $st ($d)"
			fi
		fi
	done
}

validate_remote_refs() {
	local b
	for b in "${all_branches[@]}"; do
		if ! git show-ref --verify --quiet "refs/remotes/$(upstream_display $b)"; then
			problem "$b: upstream '$(upstream_display $b)' does not exist (gone, or run git-branches-fetch)"
		fi
	done
}

evaluate() {
	local b
	for b in "${all_branches[@]}"; do
		read ab_behind ab_ahead <<< "$(git rev-list --left-right --count "refs/remotes/$(upstream_display $b)...refs/heads/$b")"
		if (( ab_ahead == 0 && ab_behind == 0 )); then
			b_state[$b]=uptodate; b_count[$b]=0
		elif (( ab_ahead == 0 )); then
			b_state[$b]=behind; b_count[$b]=$ab_behind
		elif (( ab_behind == 0 )); then
			b_state[$b]=ahead; b_count[$b]=$ab_ahead
		else
			b_state[$b]=diverged; b_count[$b]=$ab_ahead
		fi
	done
}

plural() {
	(( $1 == 1 )) && echo "$1 local commit" || echo "$1 local commits"
}

print_plan() {
	local b up st note
	local w1=0 w2=0
	for b in "${all_branches[@]}"; do
		up=$(upstream_display $b)
		(( ${#b} > w1 )) && w1=${#b}
		(( ${#up} > w2 )) && w2=${#up}
	done
	echo ""
	echo "Plan (git reset --hard to upstream):"
	for b in "${all_branches[@]}"; do
		case "${b_state[$b]}" in
			uptodate) st="up to date"; note="skipped" ;;
			behind) st="behind ${b_count[$b]}"; note="fast-forward" ;;
			ahead) st="ahead ${b_count[$b]}"; note="$(plural ${b_count[$b]}) discarded" ;;
			diverged) st="diverged"; note="$(plural ${b_count[$b]}) discarded" ;;
		esac
		printf "  %-${w1}s  %-${w2}s  %-11s %s\n" "$b" "$(upstream_display $b)" "$st" "$note"
	done
	echo ""
}

# ---------------------------------------------------------------------------
# Parse arguments
# ---------------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
	case $1 in
		--dry-run|-n) dry_run=1; shift ;;
		--disclosures|--disclosure|-d) disclosures=1; shift ;;
		--releases|-r)
			if [[ -z "$2" || "$2" == -* ]]; then
				usage_error "$1 requires a value (e.g. 7.0.1,7.0.1.1)"
			fi
			releases_arg="$2"
			releases_given=1
			shift 2
			;;
		--help|-h) usage; exit 0 ;;
		-*) usage_error "Unknown option: $1" ;;
		*) args+=("$1"); shift ;;
	esac
done

if [[ ${#args[@]} -eq 0 && $releases_given -eq 0 ]]; then
	usage_error "At least one branch is required (or use --releases)"
fi

typeset -A seen_arg
for b in "${args[@]}"; do
	if (( ${+seen_arg[$b]} )); then
		usage_error "Branch '$b' is given more than once"
	fi
	seen_arg[$b]=1
done

[[ $releases_given -eq 1 ]] && parse_releases

if ! git rev-parse --git-dir > /dev/null 2>&1; then
	echo "Error: Not in a git repository" >&2
	exit 1
fi
invoke_dir=$(git rev-parse --show-toplevel 2>/dev/null)
if [[ -z "$invoke_dir" ]]; then
	echo "Error: Must be run from a worktree (not a bare repository)" >&2
	exit 1
fi

# ---------------------------------------------------------------------------
# Main flow
# ---------------------------------------------------------------------------
build_worktree_map

for b in "${args[@]}"; do
	add_branch "$b"
	if [[ $disclosures -eq 1 ]]; then
		add_branch "disclosure/frozen/$b"
		add_branch "disclosure/active/$b"
	fi
done
for b in "${release_branches[@]}"; do
	add_branch "$b"
done

validate_local
fail_if_problems

validate_remote_refs
fail_if_problems

evaluate
print_plan

typeset -a todo
for b in "${all_branches[@]}"; do
	[[ "${b_state[$b]}" != uptodate ]] && todo+=("$b")
done

if [[ ${#todo[@]} -eq 0 ]]; then
	echo "Everything is up to date, nothing to reset."
	exit 0
fi

if [[ $dry_run -eq 1 ]]; then
	echo "Dry run, nothing was reset."
	exit 0
fi

typeset -A discarded
bw=0
for b in "${todo[@]}"; do
	ref="refs/remotes/$(upstream_display $b)"
	if [[ "${b_state[$b]}" == ahead || "${b_state[$b]}" == diverged ]]; then
		discarded[$b]="${(j:, :)${(f)$(git rev-list --abbrev-commit "$ref..refs/heads/$b")}}"
		(( ${#b} > bw )) && bw=${#b}
	fi
	if d=$(worktree_for_branch "$b"); then
		echo "Resetting $b in $d"
		git -C "$d" reset --hard --quiet "$ref" || { echo "Error: reset of $b failed" >&2; exit 1; }
	else
		echo "Resetting $b (not checked out, moving branch)"
		git branch --force "$b" "$ref" > /dev/null || { echo "Error: reset of $b failed" >&2; exit 1; }
	fi
done

echo ""
echo "Reset ${#todo[@]} branch(es), $(( ${#all_branches[@]} - ${#todo[@]} )) already up to date."
if (( ${#discarded} )); then
	echo "Discarded commits (recover with 'git branch <name> <sha>'):"
	for b in "${todo[@]}"; do
		(( ${+discarded[$b]} )) && printf "  %-${bw}s  %s\n" "$b" "${discarded[$b]}"
	done
fi
