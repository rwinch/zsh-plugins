#!/bin/zsh

# Named 'omerge' ("ours merge"), not 'git-merge-ours': git reserves
# 'merge-ours' (along with merge-resolve, merge-recursive, merge-octopus,
# merge-subtree, merge-one-file) as an internal plumbing helper for its
# merge-strategy machinery. It lives in git's exec-path, which is searched
# before $PATH, so a 'git-merge-ours' script on $PATH would never run --
# 'git merge-ours BRANCH' would silently invoke git's internal helper
# instead (confirmed via GIT_TRACE=1, which reports it as a git built-in).

# Usage function
usage() {
	cat <<EOF
Usage: git-omerge BRANCH

Forward-merge BRANCH into the current branch using the 'ours' merge
strategy (keeps the current branch's tree unchanged, discarding BRANCH's
changes), with a commit message that records the merge and its target.

ARGUMENTS:
  BRANCH   Branch to merge (required)

OPTIONS:
  --help, -h   Display this help message

BEHAVIOR:
  - Runs: git merge -s ours BRANCH
  - Opens \$EDITOR (via -e) with a prefilled commit message so it can be
    reviewed or edited before the merge commit is created:
      merge(ours): BRANCH into TARGET
    where TARGET is the current branch being merged into.

EXAMPLES:
  git-omerge 5.8.x

REQUIREMENTS:
  - Must be run from within a git repository

EOF
}

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
	usage
	exit 0
fi

if [[ -z "$1" ]]; then
	echo "Error: BRANCH is required" >&2
	echo "" >&2
	usage
	exit 1
fi

if [[ -n "$2" ]]; then
	echo "Error: Too many arguments" >&2
	echo "" >&2
	usage
	exit 1
fi

if ! git rev-parse --git-dir > /dev/null 2>&1; then
	echo "Error: Not in a git repository" >&2
	exit 1
fi

branch="$1"
current=$(git rev-parse --abbrev-ref HEAD)

git merge -s ours "$branch" -m "merge(ours): $branch into $current" -e
