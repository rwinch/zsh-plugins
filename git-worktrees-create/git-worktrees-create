#!/bin/zsh

# Default values
remote=""
owner=""
name_prefix=""
skip_missing_remote=0
typeset -a patterns

# Usage function
usage() {
	cat <<EOF
Usage: git-worktrees-create [OPTIONS] PATTERN [PATTERN ...]

Create git worktrees for the branches of a remote repository that match the given patterns.

PATTERN is a shell glob or a literal branch name. Quote globs so the shell does
not expand them. '*' also matches '/'.

OPTIONS:
  --remote REMOTE         Specify the remote name (default: repository owner)
  --name-prefix PREFIX    Prepend PREFIX to the local branch name and the worktree
                          directory, for a remote whose branch names clash with
                          local ones (commercial/docs-build -> commercial-docs-build)
  --skip-missing-remote   If the remote does not exist, say so and exit 0
  --help                  Display this help message

BEHAVIOR:
  - Fetches the remote, then iterates over all of its branches
  - For each branch that matches a pattern:
    * If the branch is already checked out in a worktree, or a worktree at
      ../{branch} exists, skips with a message
    * Otherwise:
      - Creates a local tracking branch if it doesn't exist
      - Creates a worktree at ../{branch} tracking the local branch
  - Default remote is the repository owner, auto-detected from ~/code directory structure
    (~/code/OWNER/REPOSITORY/...)

EXAMPLES:
  git-worktrees-create 'release/*' main
  git-worktrees-create --remote upstream '[0-9]*.[0-9]*.x' 'disclosure/*'
  git-worktrees-create --remote commercial --name-prefix commercial- docs-build

The gwwca function runs these patterns for you: [0-9]*.[0-9]*.x, disclosure/*,
release/*, main, docs-build, plus docs-build from the commercial remote.

REQUIREMENTS:
  - Must be run from within a git repository
  - The specified remote must exist
  - Parent directory (../) must be writable

EOF
}

# Parse arguments
while [[ $# -gt 0 ]]; do
	case $1 in
		--remote)
			if [[ -z "$2" || "$2" == --* ]]; then
				echo "Error: --remote requires a value" >&2
				echo "" >&2
				usage
				exit 1
			fi
			remote="$2"
			shift 2
			;;
		--name-prefix)
			if [[ -z "$2" || "$2" == --* ]]; then
				echo "Error: --name-prefix requires a value" >&2
				echo "" >&2
				usage
				exit 1
			fi
			name_prefix="$2"
			shift 2
			;;
		--skip-missing-remote)
			skip_missing_remote=1
			shift
			;;
		--help)
			usage
			exit 0
			;;
		--*)
			echo "Error: Unknown option: $1" >&2
			echo "" >&2
			usage
			exit 1
			;;
		*)
			patterns+=("$1")
			shift
			;;
	esac
done

if (( ${#patterns} == 0 )); then
	echo "Error: At least one PATTERN is required" >&2
	echo "" >&2
	usage
	exit 1
fi

# Validate we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
	echo "Error: Not in a git repository" >&2
	exit 1
fi

# Auto-detect owner from ~/code directory structure if remote not set
if [[ -z "$remote" ]]; then
	pwd=$(pwd)
	code_dir="$HOME/code"

	# Check if we're inside ~/code
	if [[ "$pwd" == "$code_dir"/* ]]; then
		# Remove the ~/code prefix
		relative_path="${pwd#$code_dir/}"

		# Extract owner (first directory after ~/code)
		owner=$(echo "$relative_path" | cut -d'/' -f1)

		if [[ -n "$owner" ]]; then
			remote="$owner"
		fi
	fi
fi

# Validate that we have a remote
if [[ -z "$remote" ]]; then
	echo "Error: Could not determine remote" >&2
	echo "Please provide --remote or run from within ~/code/OWNER/REPOSITORY/" >&2
	echo "" >&2
	usage
	exit 1
fi

# Validate the remote exists
if ! git remote get-url "$remote" > /dev/null 2>&1; then
	if (( skip_missing_remote )); then
		echo "Remote '$remote' does not exist, skipping"
		exit 0
	fi
	echo "Error: Remote '$remote' does not exist" >&2
	echo "" >&2
	echo "Available remotes:" >&2
	git remote -v >&2
	exit 1
fi

echo "Using remote: $remote"
echo ""

# Fetch the latest from remote
echo "Fetching from remote '$remote'..."
if ! git fetch "$remote"; then
	echo "Error: Failed to fetch from remote '$remote'" >&2
	exit 1
fi
echo ""

# Get all remote branches
remote_branches=$(git branch -r | grep "^  $remote/" | sed "s|^  $remote/||" | grep -v "HEAD")

# Worktrees are siblings of the current worktree. For a slashed branch
# (release/1.0) the worktree lives deeper, so strip the current branch name
# from the root when it matches.
root=$(git rev-parse --show-toplevel)
cur=$(git symbolic-ref --short -q HEAD)
if [[ -n "$cur" && "$root" == */"$cur" ]]; then
	base="${root%/$cur}"
else
	base="${root:h}"
fi

# Branches already checked out in some worktree: branch -> worktree path
typeset -A checked_out
wt=""
while IFS= read -r line; do
	case $line in
		"worktree "*) wt="${line#worktree }" ;;
		"branch refs/heads/"*) checked_out[${line#branch refs/heads/}]="$wt" ;;
	esac
done < <(git worktree list --porcelain)

# Process each branch
failed=0
matched_any=0
for remote_branch in ${(f)remote_branches}; do
	# Does the branch match one of the patterns?
	matched=0
	for pattern in $patterns; do
		if [[ "$remote_branch" == ${~pattern} ]]; then
			matched=1
			break
		fi
	done
	(( matched )) || continue
	matched_any=1

	branch="${name_prefix}${remote_branch}"
	worktree_path="${base}/${branch}"
	shown_path="../${branch}"

	# Check if the branch is already checked out, or a worktree already exists
	if [[ -n "${checked_out[$branch]}" ]]; then
		echo "✓ Already checked out: ${checked_out[$branch]} (branch $branch)"
	elif [[ -e "$worktree_path/.git" ]]; then
		echo "✓ Worktree already exists: $shown_path"
	else
		echo "Processing branch: $remote_branch"

		# Check if local branch exists
		if git show-ref --verify --quiet "refs/heads/$branch"; then
			echo "  → Local branch '$branch' already exists"
		else
			echo "  → Creating local branch '$branch' tracking '$remote/$remote_branch'"
			if ! git branch --track "$branch" "$remote/$remote_branch"; then
				echo "  ✗ Failed to create local branch '$branch'" >&2
				(( failed++ ))
				continue
			fi
		fi

		# Create worktree
		echo "  → Creating worktree at $shown_path"
		if git worktree add "$worktree_path" "$branch"; then
			echo "  ✓ Successfully created worktree: $shown_path"
		else
			echo "  ✗ Failed to create worktree at $shown_path" >&2
			(( failed++ ))
		fi
	fi
	echo ""
done

if (( ! matched_any )); then
	echo "Warning: no branches of '$remote' match: ${patterns[*]}"
fi

if (( failed )); then
	echo "Done, $failed failed"
	exit 1
fi
echo "Done!"
