#compdef git-branches-push gbbph gbbpha

# Complete local branch names (git's own __git_branch_names is only available once _git has been loaded)
_zp_branches() {
	local -a branches
	branches=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)"})
	_wanted branches expl 'branch' compadd -a branches
}

local -a opts
opts=(
	'(-n --dry-run)'{-n,--dry-run}'[validate and print what would be pushed, push nothing]'
	'(-e --embargoed)'{-e,--embargoed}'[arguments are OSS generations, also push their embargoed branches]'
	'(- *)'{-h,--help}'[display help message]'
)
# gbbpha already passes --embargoed, and adds --no-embargoed to leave it out
[[ $service == gbbpha ]] && opts+=('--no-embargoed[leave the embargoed branches out]')

_arguments -s $opts \
	'*:branch:_zp_branches'
