#!/bin/zsh

# ---- options ----
dry_run=0                # --dry-run
disclosures=0            # --disclosures
typeset -a branches      # positional args, in order

# ---- the branches taking part ----
typeset -a all_branches
typeset -A up_remote     # branch -> remote of its upstream
typeset -A up_branch     # branch -> branch name on that remote
typeset -a problems

# ---- the push plan: parallel arrays, one entry per branch to push ----
typeset -a push_name
typeset -a push_count    # commits ahead of the upstream
typeset -a push_remote

ab_behind=0
ab_ahead=0
nl=$'\n'

usage() {
	cat <<EOF
Usage: git-branches-push [OPTIONS] BRANCH [BRANCH ...]
       git-branches-push [OPTIONS] --disclosures GENERATION [GENERATION ...]

Pushes the branches that are ahead of their upstream, one 'git push --atomic' per
remote.

Everything is validated before anything is pushed, and all problems are reported
together: every branch exists locally, has an upstream that still exists, and is not
behind it. A branch that has diverged is a problem too. Nothing is
fetched or pulled: run git-branches-fetch and git-branches-pull first.

OPTIONS:
  --dry-run, -n        Validate and print what would be pushed. Nothing is pushed.
  --disclosures, -d    The arguments are OSS generation branches. Each is pushed with
                       its disclosure/frozen/<generation> and
                       disclosure/active/<generation> branches.
  --help, -h           Display this help message

EXAMPLES:
  git-branches-push 7.0.x main
  git-branches-push --dry-run --disclosures 7.0.x 7.1.x main
  git-branches-push \$(svaob)

REQUIREMENTS:
  - Must be run from within a git repository
  - Every branch needs an upstream (git branch --set-upstream-to=<remote>/<b> <b>)

EOF
}

usage_error() {
	echo "Error: $1" >&2
	echo "Run 'git-branches-push --help' for usage." >&2
	exit 1
}

# ---------------------------------------------------------------------------
# Problem collection
# ---------------------------------------------------------------------------
problem() {
	problems+=("$1")
}

print_problem() {
	local p="$1" first=1 l
	for l in "${(@f)p}"; do
		if (( first )); then
			echo "  - $l" >&2
			first=0
		else
			echo "      $l" >&2
		fi
	done
}

fail_if_problems() {
	[[ ${#problems[@]} -eq 0 ]] && return 0
	local p
	echo "Error: ${#problems[@]} problem(s) found. Nothing was pushed:" >&2
	for p in "${problems[@]}"; do
		print_problem "$p"
	done
	exit 1
}

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
branch_exists() {
	git show-ref --verify --quiet "refs/heads/$1"
}

# Sets ab_behind/ab_ahead for `branch` against its upstream.
ahead_behind() {
	local branch="$1"
	local ref="refs/remotes/${up_remote[$branch]}/${up_branch[$branch]}"
	read ab_behind ab_ahead <<< "$(git rev-list --left-right --count "$ref...refs/heads/$branch")"
}

upstream_display() {
	echo "${up_remote[$1]}/${up_branch[$1]}"
}

add_branch() {
	(( ${all_branches[(Ie)$1]} )) || all_branches+=("$1")
}

build_branches() {
	local b
	if [[ $disclosures -eq 0 ]]; then
		for b in "${branches[@]}"; do
			add_branch "$b"
		done
		return 0
	fi
	for b in "${branches[@]}"; do
		add_branch "$b"
		add_branch "disclosure/frozen/$b"
		add_branch "disclosure/active/$b"
	done
}

# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------
# Everything that needs no network: branches exist, upstreams set.
validate_local() {
	local b r m
	for b in "${all_branches[@]}"; do
		if ! branch_exists "$b"; then
			problem "$b: branch does not exist locally"
			continue
		fi
		r=$(git config "branch.$b.remote")
		m=$(git config "branch.$b.merge")
		if [[ -z "$r" || -z "$m" || "$r" == "." ]]; then
			problem "$b: no upstream${nl}git branch --set-upstream-to=<remote>/$b $b${nl}or: git push -u <remote> $b"
			continue
		fi
		up_remote[$b]="$r"
		up_branch[$b]="${m#refs/heads/}"
	done
}

validate_remote_refs() {
	local b
	for b in "${all_branches[@]}"; do
		[[ -z "${up_remote[$b]}" ]] && continue
		if ! git show-ref --verify --quiet "refs/remotes/${up_remote[$b]}/${up_branch[$b]}"; then
			problem "$b: upstream '$(upstream_display $b)' no longer exists on the remote (gone)${nl}git branch --set-upstream-to=<remote>/$b $b${nl}or: git push -u <remote> $b"
		fi
	done
}

# Ahead branches are pushed. Behind is a problem, and so is a diverged branch.
check_state() {
	local b
	for b in "${all_branches[@]}"; do
		[[ -z "${up_remote[$b]}" ]] && continue
		git show-ref --verify --quiet "refs/remotes/${up_remote[$b]}/${up_branch[$b]}" || continue
		ahead_behind "$b"
		[[ "$ab_behind" -eq 0 && "$ab_ahead" -eq 0 ]] && continue

		if [[ "$ab_behind" -gt 0 && "$ab_ahead" -gt 0 ]]; then
			problem "$b: diverged from $(upstream_display $b) ($ab_ahead ahead, $ab_behind behind), rebase or merge $(upstream_display $b) first"
		elif [[ "$ab_behind" -gt 0 ]]; then
			problem "$b: behind $(upstream_display $b) by $ab_behind commit(s) (run git-branches-pull)"
		else
			push_name+=("$b"); push_count+=("$ab_ahead")
			push_remote+=("${up_remote[$b]}")
		fi
	done
}

# ---------------------------------------------------------------------------
# Plan printing and pushing
# ---------------------------------------------------------------------------
typeset -a remotes
collect_remotes() {
	local r
	for r in "${push_remote[@]}"; do
		(( ${remotes[(Ie)$r]} )) || remotes+=("$r")
	done
}

print_plan() {
	local r i w=0
	for (( i = 1; i <= ${#push_name[@]}; i++ )); do
		(( ${#push_name[$i]} > w )) && w=${#push_name[$i]}
	done

	echo "Plan:"
	for r in "${remotes[@]}"; do
		echo "  $r"
		for (( i = 1; i <= ${#push_name[@]}; i++ )); do
			[[ "${push_remote[$i]}" == "$r" ]] || continue
			printf '    %-*s  ahead %s\n' "$w" "${push_name[$i]}" "${push_count[$i]}"
		done
	done
}

# Sets `refs` to the arguments of the push to remote `r`.
build_refs() {
	local r="$1" i b spec
	refs=()
	for (( i = 1; i <= ${#push_name[@]}; i++ )); do
		[[ "${push_remote[$i]}" == "$r" ]] || continue
		b="${push_name[$i]}"
		spec="$b"
		[[ "$b" == "${up_branch[$b]}" ]] || spec="$b:${up_branch[$b]}"
		refs+=("$spec")
	done
}

print_push_commands() {
	local r
	typeset -a refs
	for r in "${remotes[@]}"; do
		build_refs "$r"
		print -r -- "  git push --atomic $r \\"
		print -r -- "    ${refs[*]}"
	done
}

push_all() {
	local r i result
	local -a pushed not_pushed
	typeset -a refs
	for (( i = 1; i <= ${#remotes[@]}; i++ )); do
		r="${remotes[$i]}"
		build_refs "$r"
		printf 'Pushing %s ... ' "$r"
		if result=$(git push --atomic "$r" "${refs[@]}" 2>&1); then
			echo "done"
			pushed+=("$r")
		else
			echo "failed"
			echo "$result" >&2
			not_pushed=("${remotes[@]:$((i - 1))}")
			echo "" >&2
			echo "Error: push to '$r' failed. Pushed: ${(j:, :)pushed:-nothing}. Not pushed: ${(j:, :)not_pushed}" >&2
			exit 1
		fi
	done
}

# ---------------------------------------------------------------------------
# Parse arguments
# ---------------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
	case $1 in
		--dry-run|-n) dry_run=1; shift ;;
		--disclosures|--disclosure|-d) disclosures=1; shift ;;
		--help|-h) usage; exit 0 ;;
		-*) usage_error "Unknown option: $1" ;;
		*) branches+=("$1"); shift ;;
	esac
done

# ---------------------------------------------------------------------------
# Argument checks (no git yet)
# ---------------------------------------------------------------------------
if [[ ${#branches[@]} -eq 0 ]]; then
	usage_error "At least one branch is required"
fi
if [[ $disclosures -eq 1 && ${#branches[@]} -eq 0 ]]; then
	usage_error "--disclosures needs at least one generation branch"
fi

typeset -A seen_arg
for b in "${branches[@]}"; do
	if (( ${+seen_arg[$b]} )); then
		usage_error "Branch '$b' is given more than once"
	fi
	seen_arg[$b]=1
done

build_branches

if ! git rev-parse --git-dir > /dev/null 2>&1; then
	echo "Error: Not in a git repository" >&2
	exit 1
fi

# ---------------------------------------------------------------------------
# Main flow
# ---------------------------------------------------------------------------
# 1. Local validation: exist, upstream.
validate_local
fail_if_problems

# 2. Remote refs: upstreams exist.
validate_remote_refs
fail_if_problems

# 3. Ahead, behind or diverged.
check_state
fail_if_problems

# 4. Nothing to do?
if [[ ${#push_name[@]} -eq 0 ]]; then
	echo "Everything is up to date, nothing to push."
	exit 0
fi

collect_remotes
print_plan
echo ""

if [[ $dry_run -eq 1 ]]; then
	echo "Dry run, nothing pushed. Would run:"
	print_push_commands
	exit 0
fi

# 5. Push.
push_all

echo "Done. Pushed ${#push_name[@]} branch(es)."
