#!/bin/zsh

# Named 'gmi' ("git merge info") to sit next to 'gmo' ("git merge ours") and
# invoked as a bare command rather than a 'git <subcommand>'.

setopt extendedglob

# Branches checked when none are given: main, *.x and embargoed/(frozen|active)/(main|*.x)
default_pat='(main|[^/]##.x|embargoed/(frozen|active)/(main|[^/]##.x))'

usage() {
	cat <<EOT
Usage: gmi [--dry-run] [--full] [--limit N] COMMIT [BRANCH...]

Show how COMMIT got into each BRANCH: a regular commit on the branch, or the
chain of merges that carried it there (fixed on a, merged into b, merged into
main, ...), flagging merges done with 'ours' and merges that were edited.

ARGUMENTS:
  COMMIT   Commit ref (sha, tag, branch, ...) (required)
  BRANCH   Branch to check, as an exact ref (7.1.x, origin/7.1.x) or a glob
           ('7.*.x'). Defaults to the branches named main, *.x and
           embargoed/(frozen|active)/(main|*.x), local or on origin.

OPTIONS:
  --dry-run, -n   Print the git commands that would be used, without running
                  them and without a '\$' prefix so they can be copied
  --full, -f      Show the full patch of edited merges instead of --stat
  --limit, -l N   Show only the last N merges per branch (the ones nearest the
                  branch), with '...' where merges are hidden. -l 1 shows just
                  the merge that brought COMMIT into the branch. -l 0 shows only that
                  merge, or just COMMIT where there is no merge
  --help, -h      Display this help message

BEHAVIOR:
  - Output is never paged (git --no-pager).
  - Each git command is echoed to stderr as '\$ ...' before it runs.
  - A branch where COMMIT is on its own first-parent history shows
    only the commit (marked with '*'). Otherwise the merges are listed from the one that
    brought COMMIT into the first branch up to the one on BRANCH, even when
    COMMIT reached BRANCH through merges of merges.
  - 'ours' marks a merge whose diff against its first parent touches none of
    the files COMMIT touched. 'edited' marks a merge that differs from what
    git's automatic merge produces (conflict resolutions or hand edits, needs
    git 2.36+); its diff is shown at the end.
  - To undo a merge M on a branch, use 'git reset --hard M^'.
  - Exit status: 0 if COMMIT is in at least one branch, 1 if in none,
    2 for usage errors.

EXAMPLES:
  gmi 3f2a9c1
  gmi 3f2a9c1 7.1.x main
  gmi --dry-run 3f2a9c1 '7.*.x'

REQUIREMENTS:
  - Must be run from within a git repository

EOT
}

dry_run=false
full=false
args=()
limit=''
while (( $# )); do
	arg=$1; shift
	case "$arg" in
		--help|-h) usage; exit 0 ;;
		--dry-run|-n) dry_run=true ;;
		--full|-f) full=true ;;
		--limit|-l)
			(( $# )) || { echo "Error: $arg needs a number" >&2; exit 2; }
			limit=$1; shift ;;
		--limit=*) limit=${arg#--limit=} ;;
		-*) echo "Error: Unknown option: $arg" >&2; echo "" >&2; usage >&2; exit 2 ;;
		*) args+=("$arg") ;;
	esac
done
if [[ -n $limit && $limit != <-> ]]; then
	echo "Error: --limit needs a number: $limit" >&2
	exit 2
fi

if (( $#args < 1 )); then
	echo "Error: COMMIT is required" >&2
	echo "" >&2
	usage >&2
	exit 2
fi

if $dry_run; then
	cat <<EOT
git rev-parse --verify ${(q-)args[1]}^{commit}
git for-each-ref --format='%(refname) %(objectname)' refs/heads refs/remotes/origin   # the branches to check
git merge-base --is-ancestor <commit> <branch>
git rev-list --first-parent <branch> | grep -qxF <commit>   # a match means a regular commit on <branch>
git rev-list --topo-order --reverse --ancestry-path <commit>..<tip> | grep -F -x -f <(git rev-list --first-parent <commit>..<tip>) | head -1   # the merge; repeated on its parent that contains <commit>
git --no-pager log -1 --format='%h  %as  %s' <commit>   # shown with a '*' to the left of the sha
git --no-pager log -1 --format='%h  %as  %s' <merge>
git diff-tree --no-commit-id --name-only -r <commit>   # files the commit touched
git diff --quiet <merge>^1 <merge> -- <files>          # ours: nothing changed
git show --remerge-diff --format= <merge>              # edited: not empty
git --no-pager show --remerge-diff --format= $($full || echo '--stat ')<merge>
EOT
	exit 0
fi

if ! git rev-parse --git-dir > /dev/null 2>&1; then
	echo "Error: Not in a git repository" >&2
	exit 2
fi

dim='' reset=''
color=()
if [[ -t 1 ]]; then
	color=(-c color.ui=always)
fi
if [[ -t 2 ]]; then
	dim=$'\e[2m' reset=$'\e[0m'
fi

# Echo the command to stderr
echo_cmd() {
	print -r -u2 -- "${dim}\$ ${(j: :)${(@q-)argv}}${reset}"
}

# Echo the command to stderr, then run it
run() {
	echo_cmd "$@"
	command "$@"
}

# Same as run, but with git's color and quoting settings for the report
git_run() {
	run git --no-pager "${color[@]}" -c core.quotePath=false "$@"
}

commit=$(run git rev-parse --verify "${args[1]}^{commit}") || { echo "Error: Not a commit: ${args[1]}" >&2; exit 2; }

# ---- the branches to check ----
typeset -A tip mname   # branch name -> commit sha, branch name -> name without the origin/ prefix
refs=("${(@f)$(run git for-each-ref --format='%(refname) %(objectname)' refs/heads refs/remotes/origin)}")
for line in "${(@)refs}"; do
	[[ $line == refs/heads/* ]] || continue
	name=${${line% *}#refs/heads/}
	tip[$name]=${line##* } mname[$name]=$name
done
for line in "${(@)refs}"; do
	[[ $line == refs/remotes/origin/* ]] || continue
	name=${${line% *}#refs/remotes/}
	[[ $name == origin/HEAD ]] && continue
	(( $+tip[${name#origin/}] )) && continue   # the local branch wins
	tip[$name]=${line##* } mname[$name]=${name#origin/}
done

typeset -A selected
if (( $#args == 1 )); then
	for name in ${(k)tip}; do
		[[ ${mname[$name]} == ${~default_pat} ]] && selected[$name]=${tip[$name]}
	done
	if (( ! $#selected )); then
		echo "Error: No branches named main, *.x or embargoed/(frozen|active)/(main|*.x); name the branches to check" >&2
		exit 2
	fi
else
	for arg in "${(@)args[2,-1]}"; do
		if (( $+tip[$arg] )); then
			selected[$arg]=${tip[$arg]}
		elif sha=$(run git rev-parse --verify "$arg^{commit}" 2>/dev/null); then
			selected[$arg]=$sha
		else
			matched=false
			for name in ${(k)tip}; do
				if [[ $name == ${~arg} || ${mname[$name]} == ${~arg} ]]; then
					selected[$name]=${tip[$name]} matched=true
				fi
			done
			$matched || { echo "Error: No branch matches: $arg" >&2; exit 2; }
		fi
	done
fi
branches=(${(ko)selected})

# ---- how the commit reached a branch ----
files=("${(@f)$(run git -c core.quotePath=false diff-tree --no-commit-id --name-only -r "$commit")}")
files=("${(@)files:#}")
pathspec=()
(( $#files )) && pathspec=(-- "${files[@]}")

# Is $2 on $1's own first-parent history?
on_first_parent() {
	run git rev-list --first-parent "$1" | grep -qxF "$2"
}

# The oldest commit on $1's first-parent history that contains $commit. Comparing against the
# first-parent history (rather than using --first-parent with --ancestry-path) also finds the
# merge when the commit reached the branch through merges of merges.
first_merge() {
	run git rev-list --topo-order --reverse --ancestry-path "$commit..$1" \
		| grep -F -x -f <(run git rev-list --first-parent "$commit..$1") | head -1
}

typeset -A hopline hopflag edited   # merge sha -> its line, its flag; merge shas that were edited
remerge=true

describe_hop() {
	local m=$1 out rc
	(( $+hopline[$m] )) && return
	hopline[$m]=$(run git --no-pager log -1 --format='%h  %as  %s' "$m")
	hopflag[$m]=""
	if run git diff --quiet "$m^1" "$m" "${pathspec[@]}"; then
		if (( $#files )); then
			hopflag[$m]="ours: the merge changed none of the commit's files"
		else
			hopflag[$m]="ours: the merge produced no changes"
		fi
	elif $remerge; then
		echo_cmd git show --remerge-diff --format= "$m"
		out=$(command git show --remerge-diff --format= "$m" 2>/dev/null); rc=$?
		if (( rc == 129 )); then
			remerge=false
			echo "Note: git show --remerge-diff needs git 2.36+, so edited merges are not flagged" >&2
		elif [[ -n $out ]]; then
			hopflag[$m]="edited"
			edited[$m]=1
		fi
	fi
}

# Prints the merges that carried $commit into $1, innermost first. Empty for a regular commit.
chain() {
	local t=$1 m p
	local -a hops
	while ! on_first_parent "$t" "$commit"; do
		m=$(first_merge "$t")
		if [[ -z $m ]]; then
			echo "Error: Could not find the merge on $1's first-parent history that brought in the commit" >&2
			exit 2
		fi
		hops=("$m" "${hops[@]}")
		t=""
		for p in ${(f)"$(run git rev-parse "$m^@")"}; do
			[[ $p == $(git rev-parse "$m^1") ]] && continue
			if git merge-base --is-ancestor "$commit" "$p"; then t=$p; break; fi
		done
		if [[ -z $t ]]; then
			echo "Error: Could not find the parent of $m that contains the commit" >&2
			exit 2
		fi
	done
	print -rl -- "${hops[@]}"
}

typeset -A result cut   # branch -> 'regular' or the merges shown, one per line; branches with hidden merges
absent=()
for name in $branches; do
	if ! run git merge-base --is-ancestor "$commit" "${selected[$name]}"; then
		absent+=("$name")
		continue
	fi
	hops=$(chain "${selected[$name]}") || exit $?
	if [[ -z $hops ]]; then
		result[$name]=regular
	else
		shown=(${(f)hops})
		# -l 0 is -l 1 without the '...'
		if [[ -n $limit ]] && (( $#shown > (limit > 0 ? limit : 1) )); then
			shown=("${(@)shown[-(limit > 0 ? limit : 1),-1]}")
			(( limit > 0 )) && cut[$name]=1
		fi
		for m in $shown; do describe_hop "$m"; done
		result[$name]=${(F)shown}
	fi
done

# ---- report ----
# The original commit is marked with '*' to the left of its sha, and the other shas are indented to line up
commitline=$(run git --no-pager log -1 --format='%h  %as  %s' "$commit")
print -r -- ""
print -r -- "* $commitline"
print -r -- ""

width=0
for name in ${(k)result}; do (( $#name > width )) && width=$#name; done
for name in $branches; do
	(( $+result[$name] )) || continue
	label=$name
	# -l 0 leaves out the original commit unless it is a regular commit on the branch
	if [[ $limit != 0 || ${result[$name]} == regular ]]; then
		print -r -- "${(r:$width:)label}  * $commitline"
		label=""
	fi
	[[ ${result[$name]} == regular ]] && continue
	(( $+cut[$name] )) && print -r -- "${(r:$width:)}    ..."
	for m in ${(f)result[$name]}; do
		print -r -- "${(r:$width:)label}    ${hopline[$m]}${hopflag[$m]:+   ${hopflag[$m]}}"
		label=""
	done
done

if (( $#absent )); then
	print -r -- ""
	print -r -- "not in: ${(j:, :)absent}"
fi

if (( $#edited )); then
	stat=(--stat)
	$full && stat=()
	for m in ${(k)edited}; do
		print -r -- ""
		print -r -- "== edited merge $(git rev-parse --short "$m") (what differs from git's automatic merge) =="
		git_run show --remerge-diff --format= "${stat[@]}" "$m"
	done
fi

(( $#result )) || exit 1
exit 0
