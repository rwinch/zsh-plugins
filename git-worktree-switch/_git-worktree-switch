#compdef git-worktree-switch gws

# Complete local branch names (git's own __git_branch_names is only available once _git has been loaded)
_zp_branches() {
	local -a branches
	branches=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)"})
	_wanted branches expl 'branch' compadd -a branches
}

_git-worktree-switch() {
	local curcontext="$curcontext" state line ret=1
	typeset -A opt_args

	_arguments -s -C \
		'(-c -C -h --help)-c[create <new-branch> and a worktree for it]:new branch: ' \
		'(-c -C -h --help)-C[create or reset <new-branch> and a worktree for it]:new branch: ' \
		'(- *)'{-h,--help}'[show this help message]' \
		'1: :->arg' && ret=0

	case $state in
		arg)
			if (( ${+opt_args[-c]} || ${+opt_args[-C]} )); then
				_alternative \
					'branches:start point (branch):_zp_branches' \
					'commits:start point (commit or tag):__git_commit_tags' && ret=0
			else
				_zp_branches && ret=0
			fi
			;;
	esac

	return ret
}

_git-worktree-switch "$@"
