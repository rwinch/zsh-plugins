#!/bin/zsh

# ---- options ----
dry_run=0                # --dry-run
pause_after_release=0    # --pause
releases_arg=""          # V1,V2 (positional, comma separated)

# ---- worktree map, rebuilt by build_worktree_map ----
typeset -a wt_branches   # parallel array: branch name at index i
typeset -a wt_paths      # parallel array: worktree path at index i

# ---- the release plan: parallel arrays, one entry per release ----
typeset -a rel_version
typeset -a rel_role      # frozen | active
typeset -a rel_gen       # <major>.<minor>
typeset -a rel_base      # disclosure branch the release is based on
typeset -a rel_note      # mapping note (main fallback)
typeset -a rel_kind      # rebase | create
typeset -a rel_will      # 1 when the release would be rewritten or created
typeset -a rel_lease     # sha of the remote release branch before rewriting

typeset -a all_branches  # the base branches taking part
typeset -A up_remote     # branch -> remote of its upstream
typeset -A up_branch     # branch -> branch name on that remote
typeset -a problems

invoke_dir=""
original_ref=""
original_detached=0
ab_behind=0
ab_ahead=0
nl=$'\n'

usage() {
	cat <<EOF
Usage: git-branches-release [OPTIONS] VERSION[,VERSION ...]

Rebuild or create release/<version> branches. An existing release branch becomes
its base disclosure branch plus the commits that are only on the remote release
branch (git rebase --onto), so it needs a force push. A release branch that does
not exist yet is created from its base disclosure branch. A hotfix version
(7.0.1.1) is based on disclosure/active/<major>.<minor>.x, anything else on
disclosure/frozen/<major>.<minor>.x.

Everything is validated before anything changes, and all problems are reported
together: every base branch exists locally, has an upstream, has a clean worktree
(untracked files count) and equals its upstream as of the last fetch (nothing is
fetched or pulled: run git-branches-fetch and git-branches-pull first).
Nothing is pushed: the push commands are printed at the end.

OPTIONS:
  --dry-run, -n        Validate and print what would happen. Nothing is changed.
  --pause, -P          After each release, stop so the result can be validated,
                       and say which directory to do it in
  --help, -h           Display this help message

VERSIONS:
  <major>.<minor>.<patch>, optionally followed by .<hotfix> or -RC<n> or -M<n>
  (RC and M need patch 0). A version whose <major>.<minor>.x disclosure branches
  do not exist maps to the 'main' disclosure branches, but only when it is the
  next generation after the newest existing one. At most one version per base
  branch (one hotfix and one non-hotfix per generation).

EXAMPLES:
  git-branches-release 7.0.1,7.0.1.1
  git-branches-release --dry-run 7.0.1 7.1.0-RC1
  git-branches-release -n 7.1.0

REQUIREMENTS:
  - Must be run from within a git repository
  - Every base branch needs an upstream (git branch --set-upstream-to=<remote>/<b> <b>)
  - Every worktree touched must be clean (no untracked files either)

EOF
}

usage_error() {
	echo "Error: $1" >&2
	echo "Run 'git-branches-release --help' for usage." >&2
	exit 1
}

# ---------------------------------------------------------------------------
# Problem collection
# ---------------------------------------------------------------------------
problem() {
	problems+=("$1")
}

print_problem() {
	local p="$1" first=1 l
	for l in "${(@f)p}"; do
		if (( first )); then
			echo "  - $l" >&2
			first=0
		else
			echo "      $l" >&2
		fi
	done
}

fail_if_problems() {
	[[ ${#problems[@]} -eq 0 ]] && return 0
	local p
	echo "Error: ${#problems[@]} problem(s) found. Nothing was changed:" >&2
	for p in "${problems[@]}"; do
		print_problem "$p"
	done
	exit 1
}

# ---------------------------------------------------------------------------
# Worktrees
# ---------------------------------------------------------------------------
build_worktree_map() {
	local current_path=""
	local line

	wt_branches=()
	wt_paths=()

	while IFS= read -r line; do
		case "$line" in
			"worktree "*)
				current_path="${line#worktree }"
				;;
			"branch "*)
				local ref="${line#branch }"
				wt_branches+=("${ref#refs/heads/}")
				wt_paths+=("$current_path")
				;;
			"")
				current_path=""
				;;
		esac
	done < <(git -C "$invoke_dir" worktree list --porcelain)
}

# Echoes the directory for a branch: its worktree if it is checked out
# somewhere, otherwise the directory the tool was run from.
resolve_dir_for_branch() {
	local branch="$1" i

	for (( i = 1; i <= ${#wt_branches[@]}; i++ )); do
		if [[ "${wt_branches[$i]}" == "$branch" ]]; then
			echo "${wt_paths[$i]}"
			return 0
		fi
	done
	echo "$invoke_dir"
}

branch_exists() {
	git show-ref --verify --quiet "refs/heads/$1"
}

# Echoes the name of an operation in progress in `dir` (merge, rebase, ...).
in_progress_state() {
	local dir="$1" gd f
	gd=$(git -C "$dir" rev-parse --absolute-git-dir 2>/dev/null) || return 1
	for f in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
		if [[ -e "$gd/$f" ]]; then
			case "$f" in
				MERGE_HEAD) echo "a merge is in progress (git -C \"$dir\" merge --abort, or commit it)" ;;
				CHERRY_PICK_HEAD) echo "a cherry-pick is in progress (git -C \"$dir\" cherry-pick --abort)" ;;
				REVERT_HEAD) echo "a revert is in progress (git -C \"$dir\" revert --abort)" ;;
				*) echo "a rebase is in progress (git -C \"$dir\" rebase --abort, or finish it)" ;;
			esac
			return 0
		fi
	done
	return 1
}

rebase_in_progress() {
	local gd
	gd=$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null) || return 1
	[[ -e "$gd/rebase-merge" || -e "$gd/rebase-apply" ]]
}

# Sets ab_behind/ab_ahead for `branch` against its upstream.
ahead_behind() {
	local branch="$1"
	local ref="refs/remotes/${up_remote[$branch]}/${up_branch[$branch]}"
	read ab_behind ab_ahead <<< "$(git rev-list --left-right --count "$ref...refs/heads/$branch")"
}

upstream_display() {
	echo "${up_remote[$1]}/${up_branch[$1]}"
}

add_branch() {
	(( ${all_branches[(Ie)$1]} )) || all_branches+=("$1")
}

# ---------------------------------------------------------------------------
# Releases
# ---------------------------------------------------------------------------
# Parses and checks the versions (no git needed).
parse_releases() {
	local -a items
	local v key
	local -A seen_version seen_base
	items=("${(@s:,:)releases_arg}")
	local major minor patch hotfix pre

	for v in "${items[@]}"; do
		if [[ ! "$v" =~ '^([0-9]+)\.([0-9]+)\.([0-9]+)(\.([0-9]+)|-(RC[0-9]+|M[0-9]+))?$' ]]; then
			usage_error "Invalid release version '$v' (expected <major>.<minor>.<patch>, optionally .<hotfix> or -RC<n> or -M<n>)"
		fi
		major="${match[1]}"; minor="${match[2]}"; patch="${match[3]}"; hotfix="${match[5]}"; pre="${match[6]}"
		if [[ -n "$pre" && "$patch" != 0 ]]; then
			usage_error "Invalid release version '$v' (an RC or M version must have patch 0)"
		fi
		if (( ${+seen_version[$v]} )); then
			usage_error "Release version '$v' is given more than once"
		fi
		seen_version[$v]=1
		local role=frozen
		[[ -n "$hotfix" ]] && role=active
		key="$role/$major.$minor"
		if (( ${+seen_base[$key]} )); then
			usage_error "Release versions '${seen_base[$key]}' and '$v' are both based on disclosure/$role/$major.$minor.x (at most one per base branch)"
		fi
		seen_base[$key]="$v"
		rel_version+=("$v")
		rel_role+=("$role")
		rel_gen+=("$major.$minor")
		rel_base+=("")
		rel_note+=("")
		rel_kind+=(rebase)
		rel_will+=(0)
		rel_lease+=("")
	done
}

# Maps every release to its base disclosure branch (needs the local branches).
map_release_bases() {
	local -a existing missing_gens
	local ref name i gen
	local -A exists_gen missing_versions

	while IFS= read -r ref; do
		if [[ "$ref" =~ '^disclosure/(frozen|active)/([0-9]+\.[0-9]+)\.x$' ]]; then
			exists_gen[${match[2]}]=1
		fi
	done < <(git for-each-ref --format='%(refname:short)' refs/heads/disclosure)

	for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
		gen="${rel_gen[$i]}"
		if (( ${+exists_gen[$gen]} )); then
			rel_base[$i]="disclosure/${rel_role[$i]}/$gen.x"
		else
			missing_versions[$gen]+="${missing_versions[$gen]:+, }${rel_version[$i]}"
			(( ${missing_gens[(Ie)$gen]} )) || missing_gens+=("$gen")
		fi
	done

	[[ ${#missing_gens[@]} -eq 0 ]] && return 0

	if [[ ${#exists_gen} -eq 0 ]]; then
		problem "No disclosure/*/<major>.<minor>.x branches exist locally, so releases ${(j:, :)${(v)missing_versions}} cannot be mapped"
		return 0
	fi

	local newest="" nmaj=-1 nmin=-1 g gmaj gmin
	for g in ${(k)exists_gen}; do
		gmaj=${g%%.*}; gmin=${g##*.}
		if (( gmaj > nmaj || (gmaj == nmaj && gmin > nmin) )); then
			nmaj=$gmaj; nmin=$gmin; newest="$g"
		fi
	done

	if [[ ${#missing_gens[@]} -gt 1 ]]; then
		for g in "${missing_gens[@]}"; do
			problem "Release(s) ${missing_versions[$g]}: no disclosure/*/$g.x branches, and several newer generations are given (${(j:, :)missing_gens}), so none can map to main"
		done
		return 0
	fi

	g="${missing_gens[1]}"
	local cand1="$nmaj.$((nmin + 1))" cand2="$((nmaj + 1)).0"
	if [[ "$g" != "$cand1" && "$g" != "$cand2" ]]; then
		problem "Release(s) ${missing_versions[$g]}: no disclosure/*/$g.x branches, and $g is not the generation after the newest existing one ($newest, next is $cand1 or $cand2), so it cannot map to main"
		return 0
	fi
	for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
		if [[ "${rel_gen[$i]}" == "$g" ]]; then
			rel_base[$i]="disclosure/${rel_role[$i]}/main"
			rel_note[$i]="no $g.x branch, newest generation"
		fi
	done
}

# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------
check_dir() {
	local dir="$1" label="$2" st state count
	st=$(git -C "$dir" status --porcelain)
	if [[ -n "$st" ]]; then
		count=${#${(f)st}}
		problem "$label: working tree not clean, $count change(s) ($dir)"
	fi
	if state=$(in_progress_state "$dir"); then
		problem "$label: $state"
	fi
}

# Everything that needs no network: branches exist, worktrees clean, upstreams set.
validate_local() {
	local b d r m
	local -A dir_label

	for b in "${all_branches[@]}"; do
		if ! branch_exists "$b"; then
			problem "$b: branch does not exist locally${nl}git branch $b <remote>/$b"
			continue
		fi
		d=$(resolve_dir_for_branch "$b")
		dir_label[$d]="${dir_label[$d]:+${dir_label[$d]}, }$b"

		r=$(git config "branch.$b.remote")
		m=$(git config "branch.$b.merge")
		if [[ -z "$r" || -z "$m" || "$r" == "." ]]; then
			problem "$b: no upstream${nl}git branch --set-upstream-to=<remote>/$b $b${nl}or: git push -u <remote> $b"
			continue
		fi
		up_remote[$b]="$r"
		up_branch[$b]="${m#refs/heads/}"
	done

	local i rb
	for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
		rb="release/${rel_version[$i]}"
		if branch_exists "$rb"; then
			d=$(resolve_dir_for_branch "$rb")
		else
			d="$invoke_dir"
		fi
		dir_label[$d]="${dir_label[$d]:+${dir_label[$d]}, }$rb"
	done

	for d in ${(k)dir_label}; do
		check_dir "$d" "${dir_label[$d]}"
	done
}

# Upstream refs exist. Decides for every release whether it is rebuilt (it
# exists on the remote of its base) or created (it exists nowhere).
validate_remote_refs() {
	local b i rb rr base
	for b in "${all_branches[@]}"; do
		[[ -z "${up_remote[$b]}" ]] && continue
		if ! git show-ref --verify --quiet "refs/remotes/${up_remote[$b]}/${up_branch[$b]}"; then
			problem "$b: upstream '$(upstream_display $b)' no longer exists on the remote (gone)${nl}git branch --set-upstream-to=<remote>/$b $b${nl}or: git push -u <remote> $b"
		fi
	done

	for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
		rb="release/${rel_version[$i]}"
		base="${rel_base[$i]}"
		[[ -z "${up_remote[$base]}" ]] && continue
		rr="${up_remote[$base]}"
		if ! git show-ref --verify --quiet "refs/remotes/$rr/$rb"; then
			if branch_exists "$rb"; then
				problem "$rb: exists locally but not on '$rr' (delete the local branch to have it created from $base, or push it first)"
			else
				rel_kind[$i]=create
			fi
			continue
		fi
		rel_kind[$i]=rebase
		if git rev-list --merges "refs/remotes/$rr/$rb" "^refs/remotes/${up_remote[$base]}/${up_branch[$base]}" | grep -q .; then
			problem "$rb: has merge commit(s) that are not on $(upstream_display $base), which a rebase would flatten:${nl}$(git rev-list --merges --oneline "refs/remotes/$rr/$rb" "^refs/remotes/${up_remote[$base]}/${up_branch[$base]}")"
		fi
		if branch_exists "$rb"; then
			local lsha rsha
			lsha=$(git rev-parse "refs/heads/$rb")
			rsha=$(git rev-parse "refs/remotes/$rr/$rb")
			if [[ "$lsha" != "$rsha" ]]; then
				problem "$rb: local branch differs from $rr/$rb (run git-branches-pull if it is only behind, otherwise reset or delete the local branch)"
			fi
		fi
	done
}

# Every base branch must match its upstream.
check_up_to_date() {
	local b unpushed
	for b in "${all_branches[@]}"; do
		[[ -z "${up_remote[$b]}" ]] && continue
		git show-ref --verify --quiet "refs/remotes/${up_remote[$b]}/${up_branch[$b]}" || continue
		ahead_behind "$b"
		[[ "$ab_behind" -eq 0 && "$ab_ahead" -eq 0 ]] && continue

		if [[ "$ab_behind" -gt 0 && "$ab_ahead" -gt 0 ]]; then
			problem "$b: diverged from $(upstream_display $b) ($ab_ahead ahead, $ab_behind behind), rebase or merge $(upstream_display $b) first"
		elif [[ "$ab_behind" -gt 0 ]]; then
			problem "$b: behind $(upstream_display $b) by $ab_behind commit(s) (run git-branches-pull)"
		else
			unpushed=$(git log --oneline -5 "refs/remotes/${up_remote[$b]}/${up_branch[$b]}..refs/heads/$b")
			problem "$b: ahead of $(upstream_display $b) by $ab_ahead commit(s), push it first${nl}${unpushed}"
		fi
	done
}

# ---------------------------------------------------------------------------
# Plan evaluation and printing
# ---------------------------------------------------------------------------
evaluate_plan() {
	local i rr base rb
	for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
		if [[ "${rel_kind[$i]}" == create ]]; then
			rel_will[$i]=1
			continue
		fi
		base="${rel_base[$i]}"
		rb="release/${rel_version[$i]}"
		rr="${up_remote[$base]}"
		if git merge-base --is-ancestor "refs/heads/$base" "refs/remotes/$rr/$rb"; then
			rel_will[$i]=0
		else
			rel_will[$i]=1
		fi
	done
}

everything_noop() {
	local i
	for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
		[[ "${rel_will[$i]}" -eq 1 ]] && return 1
	done
	return 0
}

print_plan() {
	local i w=0 wb=0 base rb rr count
	for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
		(( ${#rel_version[$i]} + 8 > w )) && w=$(( ${#rel_version[$i]} + 8 ))
		(( ${#rel_base[$i]} > wb )) && wb=${#rel_base[$i]}
	done

	echo "Plan:"
	for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
		base="${rel_base[$i]}"
		rb="release/${rel_version[$i]}"
		rr="${up_remote[$base]}"
		if [[ "${rel_kind[$i]}" == create ]]; then
			printf '  %-*s on %-*s  would create from %s\n' "$w" "$rb" "$wb" "$base" "$(upstream_display $base)"
		elif [[ "${rel_will[$i]}" -eq 1 ]]; then
			count=$(git rev-list --count "refs/remotes/$rr/$rb" "^refs/remotes/$rr/${up_branch[$base]}")
			printf '  %-*s on %-*s  would rebase %s commit(s) [%s]\n' "$w" "$rb" "$wb" "$base" "$count" "$rr"
		else
			printf '  %-*s on %-*s  up to date [%s]\n' "$w" "$rb" "$wb" "$base" "$rr"
		fi
		[[ -n "${rel_note[$i]}" ]] && echo "        (${rel_note[$i]})"
	done
}

# One 'git push --atomic' per remote. A created release is pushed plainly, a
# rebuilt one is forced with a lease on the sha it had when it was fetched.
print_push_commands() {
	local -a remotes refs
	local i rb r base
	for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
		[[ "${rel_will[$i]}" -eq 1 ]] || continue
		r="${up_remote[${rel_base[$i]}]}"
		(( ${remotes[(Ie)$r]} )) || remotes+=("$r")
	done

	for r in "${remotes[@]}"; do
		refs=()
		for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
			[[ "${rel_will[$i]}" -eq 1 ]] || continue
			[[ "${up_remote[${rel_base[$i]}]}" == "$r" ]] || continue
			rb="release/${rel_version[$i]}"
			if [[ "${rel_kind[$i]}" == create ]]; then
				refs+=("$rb")
			else
				refs+=("+$rb")
			fi
		done
		for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
			[[ "${rel_will[$i]}" -eq 1 && "${rel_kind[$i]}" == rebase ]] || continue
			[[ "${up_remote[${rel_base[$i]}]}" == "$r" ]] || continue
			rb="release/${rel_version[$i]}"
			refs+=("--force-with-lease=${rb}:${rel_lease[$i]}")
		done
		print -r -- "  git push --atomic $r \\"
		print -r -- "    ${refs[*]}"
	done
}

# ---------------------------------------------------------------------------
# Interactive helpers
# ---------------------------------------------------------------------------
read_tty() {
	local dir="$1"
	local response
	if ! read -r response </dev/tty; then
		echo "Error: No terminal available to prompt for input (dir: $dir)" >&2
		exit 1
	fi
	REPLY_TTY="$response"
}

prompt_retry() {
	local dir="$1"
	echo ""
	echo "Fix it in $dir, then:"
	echo "[Enter=retry / Ctrl+C=abort]"
	read_tty "$dir"
}

handle_rebase_conflict() {
	local dir="$1" branch="$2" base="$3"

	echo ""
	echo "✗ Rebase of '$branch' onto '$base' stopped"
	echo ""
	echo "Resolve conflicts in: $dir"
	echo "Then run:"
	echo "  git -C \"$dir\" add <conflicted files>   (or: git -C \"$dir\" add -A)"
	echo "  git -C \"$dir\" rebase --continue"
	echo ""

	while true; do
		echo "Resolved? [Enter=resume / Ctrl+C=abort]"
		read_tty "$dir"
		if rebase_in_progress "$dir"; then
			echo ""
			echo "Still not resolved: a rebase is still in progress in $dir"
			echo ""
			continue
		fi
		echo "✓ Rebase finished"
		return 0
	done
}

pause_for_validation() {
	local dir="$1" what="$2"

	echo ""
	echo "⏸  Paused after $what."
	echo "You can validate the result (e.g. build and run the tests) in: $dir"
	echo "[Enter=continue / Ctrl+C=abort]"
	read_tty "$dir"
}

# ---------------------------------------------------------------------------
# Updating releases
# ---------------------------------------------------------------------------
create_release() {
	local i="$1"
	local rb="release/${rel_version[$i]}" base="${rel_base[$i]}"

	printf 'Creating %s from %s ... ' "$rb" "$(upstream_display $base)"
	if ! git branch "$rb" "refs/heads/$base" > /dev/null 2>&1; then
		echo ""
		echo "Error: cannot create local branch '$rb' from '$base'" >&2
		exit 1
	fi
	echo "done"
}

update_release() {
	local i="$1"
	local rb="release/${rel_version[$i]}" base="${rel_base[$i]}"
	local rr="${up_remote[$base]}"
	local rref="refs/remotes/$rr/$rb"
	local bref="refs/remotes/$rr/${up_branch[$base]}"
	local dir rc

	if [[ "${rel_kind[$i]}" == create ]]; then
		create_release "$i"
		if [[ $pause_after_release -eq 1 ]]; then
			pause_for_validation "$invoke_dir" "creating '$rb' from '$base'"
		fi
		return 0
	fi

	if git merge-base --is-ancestor "refs/heads/$base" "$rref"; then
		echo "✓ '$rb' already contains '$base'"
		rel_will[$i]=0
		return 0
	fi
	rel_will[$i]=1
	rel_lease[$i]=$(git rev-parse "$rref")

	if ! branch_exists "$rb"; then
		echo "Creating local branch '$rb' from '$rr/$rb'"
		if ! git branch --track "$rb" "$rref" > /dev/null 2>&1; then
			echo "Error: cannot create local branch '$rb' from '$rr/$rb'" >&2
			exit 1
		fi
	fi

	while true; do
		build_worktree_map
		dir=$(resolve_dir_for_branch "$rb")
		printf 'Rebasing %s onto %s ... ' "$rb" "$base"

		git -C "$dir" rebase -q --onto "refs/heads/$base" "$bref" "$rb"
		rc=$?

		if rebase_in_progress "$dir"; then
			echo ""
			handle_rebase_conflict "$dir" "$rb" "$base"
		elif [[ $rc -ne 0 ]]; then
			echo ""
			echo "✗ Rebase of '$rb' onto '$base' failed (not a conflict)" >&2
			prompt_retry "$dir"
			continue
		fi

		if ! git merge-base --is-ancestor "refs/heads/$base" "refs/heads/$rb"; then
			echo ""
			echo "✗ '$rb' does not contain '$base' yet (was the rebase aborted?)" >&2
			prompt_retry "$dir"
			continue
		fi
		break
	done

	echo "done"

	if [[ $pause_after_release -eq 1 ]]; then
		pause_for_validation "$dir" "rebuilding '$rb' on '$base'"
	fi
}

on_abort() {
	echo "" >&2
	echo "Aborted. The directory $invoke_dir was started on '$original_ref' (not restored)." >&2
	exit 130
}

restore_original_branch() {
	local current
	current=$(git -C "$invoke_dir" rev-parse --abbrev-ref HEAD)
	if [[ $original_detached -eq 1 ]]; then
		[[ "$(git -C "$invoke_dir" rev-parse HEAD)" == "$original_ref" ]] && return 0
		git -C "$invoke_dir" checkout --detach --quiet "$original_ref" || echo "⚠️  Could not restore $invoke_dir to $original_ref" >&2
	else
		[[ "$current" == "$original_ref" ]] && return 0
		if git -C "$invoke_dir" checkout --quiet "$original_ref"; then
			echo "Restored '$original_ref' in $invoke_dir"
		else
			echo "⚠️  Could not restore '$original_ref' in $invoke_dir" >&2
		fi
	fi
}

# ---------------------------------------------------------------------------
# Parse arguments
# ---------------------------------------------------------------------------
typeset -a version_args
while [[ $# -gt 0 ]]; do
	case $1 in
		--dry-run|-n) dry_run=1; shift ;;
		--pause|-P) pause_after_release=1; shift ;;
		--help|-h) usage; exit 0 ;;
		-*) usage_error "Unknown option: $1" ;;
		*) version_args+=("$1"); shift ;;
	esac
done

# ---------------------------------------------------------------------------
# Argument checks (no git yet)
# ---------------------------------------------------------------------------
[[ ${#version_args[@]} -ge 1 ]] || usage_error "At least one release version is required (e.g. 7.0.1,7.0.1.1)"
releases_arg="${(j:,:)version_args}"
parse_releases

if ! git rev-parse --git-dir > /dev/null 2>&1; then
	echo "Error: Not in a git repository" >&2
	exit 1
fi

# ---------------------------------------------------------------------------
# Main flow
# ---------------------------------------------------------------------------
invoke_dir=$(git rev-parse --show-toplevel 2>/dev/null)
if [[ -z "$invoke_dir" ]]; then
	echo "Error: Must be run from a worktree (not a bare repository)" >&2
	exit 1
fi
original_ref=$(git -C "$invoke_dir" rev-parse --abbrev-ref HEAD)
if [[ "$original_ref" == "HEAD" ]]; then
	original_detached=1
	original_ref=$(git -C "$invoke_dir" rev-parse HEAD)
fi

build_worktree_map

map_release_bases
for (( i = 1; i <= ${#rel_base[@]}; i++ )); do
	[[ -n "${rel_base[$i]}" ]] && add_branch "${rel_base[$i]}"
done

# 1. Local validation: exist, upstream, clean.
validate_local
fail_if_problems

# 2. Remote refs: upstreams exist, release branches rebuilt or created.
validate_remote_refs
fail_if_problems

# 3. Every base branch must match its upstream.
check_up_to_date
fail_if_problems

# 4. Nothing to do?
evaluate_plan
if everything_noop; then
	echo "Everything is up to date, nothing to rebase."
	exit 0
fi

print_plan

if [[ $dry_run -eq 1 ]]; then
	echo ""
	echo "Dry run, nothing changed."
	exit 0
fi

# 5. Rebuild or create the releases.
trap on_abort INT
echo ""
for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
	update_release "$i"
done
trap - INT

# 6. Finish.
echo ""
build_worktree_map
restore_original_branch

echo ""
echo "Done. Push when ready:"
print_push_commands
