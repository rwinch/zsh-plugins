#!/bin/zsh

# ---- options ----
dry_run=0                # --dry-run
undo=0                   # --undo
force_undo=0             # --force-undo
done_word="reset"        # reset | undone, for the problem report
embargoed=0              # --embargoed
typeset -a args          # positional args, in order

typeset -a wt_branches   # parallel array: branch name at index i
typeset -a wt_paths      # parallel array: worktree path at index i
typeset -a all_branches  # every branch to reset, in order
typeset -A up_remote     # branch -> remote of its upstream
typeset -A up_branch     # branch -> branch name on that remote
typeset -A b_state       # branch -> uptodate | behind | ahead | diverged
typeset -A b_count       # branch -> number of commits behind, or of local commits to discard
typeset -A u_state       # branch -> restore | same | none (--undo)
typeset -A u_old         # branch -> sha before the reset
typeset -A u_new         # branch -> sha the reset left
typeset -A u_cur         # branch -> sha now
typeset -A u_count       # branch -> commits the restore brings back
typeset -a problems

invoke_dir=""
ab_behind=0
ab_ahead=0
nl=$'\n'

usage() {
	cat <<EOF
Usage: git-branches-reset-to-upstream [OPTIONS] BRANCH1 [BRANCH2 ...]
       git-branches-reset-to-upstream [OPTIONS] --embargoed GENERATION [GENERATION ...]
       git-branches-reset-to-upstream --undo [OPTIONS] (same arguments)

Hard reset every given branch to its remote tracked (upstream) branch as of the
last fetch (nothing is fetched: run git-branches-fetch first). A branch checked out in a worktree is reset in that worktree, any
other branch is moved with 'git branch -f'. Local commits are discarded; their
SHAs are printed at the end so they can be recovered.

Everything is validated before anything changes, and all problems are reported
together: every branch exists locally, has an upstream, and its worktree (if
any) is clean (untracked files count). Nothing is pushed.

OPTIONS:
  --dry-run, -n        Validate and print what would happen. Nothing is reset
                       (with --undo: nothing is undone).
  --undo, -u           Move every branch back to where it was before its most recent
                       reset by this command, found in the branch reflog. A branch
                       that has moved since that reset (new commits, pull, another
                       reset) is a problem and nothing is undone. A branch with no
                       reset in its reflog is skipped. Takes the same arguments.
  --force-undo         Like --undo, but also restore branches that have moved since
                       the reset, discarding the commits made since.
  --embargoed, -e      The arguments are OSS generation branches (7.0.x 7.1.x main).
                       Each is reset together with embargoed/frozen/<generation>
                       and embargoed/active/<generation>.
  --help, -h           Display this help message

EXAMPLES:
  git-branches-reset-to-upstream 7.0.x main
  git-branches-reset-to-upstream --dry-run --embargoed 7.0.x 7.1.x main
  git-branches-reset-to-upstream --undo --dry-run 7.0.x main   # what would restoring the last reset do
  git-branches-reset-to-upstream --undo 7.0.x main
  git-branches-reset-to-upstream \$(svaob)   # the OSS branches

REQUIREMENTS:
  - Must be run from within a git repository
  - Every branch needs an upstream (git branch --set-upstream-to=<remote>/<b> <b>)
  - Every worktree touched must be clean (no untracked files either)

EOF
}

usage_error() {
	echo "Error: $1" >&2
	echo "Run 'git-branches-reset-to-upstream --help' for usage." >&2
	exit 1
}

problem() {
	problems+=("$1")
}

fail_if_problems() {
	[[ ${#problems[@]} -eq 0 ]] && return 0
	local p first l
	echo "Error: ${#problems[@]} problem(s) found. Nothing was $done_word:" >&2
	for p in "${problems[@]}"; do
		first=1
		for l in "${(@f)p}"; do
			if (( first )); then
				echo "  - $l" >&2
				first=0
			else
				echo "      $l" >&2
			fi
		done
	done
	exit 1
}

build_worktree_map() {
	local current_path="" line ref
	wt_branches=()
	wt_paths=()
	while IFS= read -r line; do
		case "$line" in
			"worktree "*) current_path="${line#worktree }" ;;
			"branch "*)
				ref="${line#branch }"
				wt_branches+=("${ref#refs/heads/}")
				wt_paths+=("$current_path")
				;;
			"") current_path="" ;;
		esac
	done < <(git -C "$invoke_dir" worktree list --porcelain)
}

# Echoes the worktree where a branch is checked out, nothing when it is not.
worktree_for_branch() {
	local i
	for (( i = 1; i <= ${#wt_branches[@]}; i++ )); do
		if [[ "${wt_branches[$i]}" == "$1" ]]; then
			echo "${wt_paths[$i]}"
			return 0
		fi
	done
	return 1
}

branch_exists() {
	git show-ref --verify --quiet "refs/heads/$1"
}

upstream_display() {
	echo "${up_remote[$1]}/${up_branch[$1]}"
}

# Echoes a message when a merge, cherry-pick, revert or rebase is in progress in `dir`.
in_progress_state() {
	local dir="$1" gd f
	gd=$(git -C "$dir" rev-parse --absolute-git-dir 2>/dev/null) || return 1
	for f in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
		if [[ -e "$gd/$f" ]]; then
			echo "a merge, cherry-pick, revert or rebase is in progress, abort or finish it first"
			return 0
		fi
	done
	return 1
}

add_branch() {
	(( ${all_branches[(Ie)$1]} )) || all_branches+=("$1")
}

# Branches exist, upstreams are set, worktrees are clean.
validate_local() {
	local b d r m st
	for b in "${all_branches[@]}"; do
		if ! branch_exists "$b"; then
			problem "$b: branch does not exist locally${nl}git branch --track $b <remote>/$b"
			continue
		fi
		r=$(git config "branch.$b.remote")
		m=$(git config "branch.$b.merge")
		if [[ -z "$r" || -z "$m" || "$r" == "." ]]; then
			problem "$b: no upstream${nl}git branch --set-upstream-to=<remote>/$b $b"
			continue
		fi
		up_remote[$b]="$r"
		up_branch[$b]="${m#refs/heads/}"
		if d=$(worktree_for_branch "$b"); then
			st=$(git -C "$d" status --porcelain)
			if [[ -n "$st" ]]; then
				problem "$b: working tree not clean, ${#${(f)st}} change(s) ($d)"
			fi
			if st=$(in_progress_state "$d"); then
				problem "$b: $st ($d)"
			fi
		fi
	done
}

validate_remote_refs() {
	local b
	for b in "${all_branches[@]}"; do
		if ! git show-ref --verify --quiet "refs/remotes/$(upstream_display $b)"; then
			problem "$b: upstream '$(upstream_display $b)' does not exist (gone, or run git-branches-fetch)"
		fi
	done
}

evaluate() {
	local b
	for b in "${all_branches[@]}"; do
		read ab_behind ab_ahead <<< "$(git rev-list --left-right --count "refs/remotes/$(upstream_display $b)...refs/heads/$b")"
		if (( ab_ahead == 0 && ab_behind == 0 )); then
			b_state[$b]=uptodate; b_count[$b]=0
		elif (( ab_ahead == 0 )); then
			b_state[$b]=behind; b_count[$b]=$ab_behind
		elif (( ab_behind == 0 )); then
			b_state[$b]=ahead; b_count[$b]=$ab_ahead
		else
			b_state[$b]=diverged; b_count[$b]=$ab_ahead
		fi
	done
}

plural() {
	(( $1 == 1 )) && echo "$1 local commit" || echo "$1 local commits"
}

print_plan() {
	local b up st note
	local w1=0 w2=0
	for b in "${all_branches[@]}"; do
		up=$(upstream_display $b)
		(( ${#b} > w1 )) && w1=${#b}
		(( ${#up} > w2 )) && w2=${#up}
	done
	echo ""
	echo "Plan (git reset --hard to upstream):"
	for b in "${all_branches[@]}"; do
		case "${b_state[$b]}" in
			uptodate) st="up to date"; note="skipped" ;;
			behind) st="behind ${b_count[$b]}"; note="fast-forward" ;;
			ahead) st="ahead ${b_count[$b]}"; note="$(plural ${b_count[$b]}) discarded" ;;
			diverged) st="diverged"; note="$(plural ${b_count[$b]}) discarded" ;;
		esac
		printf "  %-${w1}s  %-${w2}s  %-11s %s\n" "$b" "$(upstream_display $b)" "$st" "$note"
	done
	echo ""
}

# Finds, per branch, the most recent reset to its upstream by this command in the
# branch reflog (a worktree reset logs 'reset: moving to <ref>', a moved branch
# 'branch: Reset to <ref>', where <ref> is the full upstream ref), and the sha the
# branch had before it.
plan_undo() {
	local b want subj i found
	local -a lines
	for b in "${all_branches[@]}"; do
		want="refs/remotes/$(upstream_display $b)"
		lines=("${(@f)$(git reflog show --format='%H %gs' "refs/heads/$b")}")
		found=0
		for (( i = 1; i < ${#lines[@]}; i++ )); do
			subj="${lines[i]#* }"
			if [[ "$subj" == "reset: moving to $want" || "$subj" == "branch: Reset to $want" ]]; then
				found=$i
				break
			fi
		done
		if (( found == 0 )); then
			u_state[$b]=none
			continue
		fi
		u_new[$b]="${lines[found]%% *}"
		u_old[$b]="${lines[found+1]%% *}"
		u_cur[$b]=$(git rev-parse "refs/heads/$b")
		if [[ "${u_cur[$b]}" == "${u_old[$b]}" ]]; then
			u_state[$b]=same
			continue
		fi
		u_state[$b]=restore
		u_count[$b]=$(git rev-list --count "${u_cur[$b]}..${u_old[$b]}")
		if [[ "${u_cur[$b]}" != "${u_new[$b]}" && $force_undo -eq 0 ]]; then
			problem "$b: has moved since the reset (now at ${u_cur[$b]:0:7}, the reset left it at ${u_new[$b]:0:7})${nl}use --force-undo to restore it anyway, which discards the commits made since"
		fi
	done
}

restored_commits() {
	(( $1 == 1 )) && echo "$1 commit restored" || echo "$1 commits restored"
}

print_undo_plan() {
	local b w=0 d where how
	for b in "${all_branches[@]}"; do
		(( ${#b} > w )) && w=${#b}
	done
	echo ""
	if (( dry_run )); then echo "Would undo:"; else echo "Undo plan:"; fi
	for b in "${all_branches[@]}"; do
		case "${u_state[$b]}" in
			none) printf "  %-${w}s  no reset found in the reflog, skipped\n" "$b" ;;
			same) printf "  %-${w}s  already at %s, nothing to undo\n" "$b" "${u_old[$b]:0:7}" ;;
			restore)
				if d=$(worktree_for_branch "$b"); then where="in $d"; else where="(not checked out, moving branch)"; fi
				printf "  %-${w}s  %s is at %s, was %s before the reset (%s)  %s\n" "$b" "$b" "${u_cur[$b]:0:7}" "${u_old[$b]:0:7}" \
					"$(restored_commits ${u_count[$b]})" "$where"
				;;
		esac
	done
	echo ""
}

# ---------------------------------------------------------------------------
# Parse arguments
# ---------------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
	case $1 in
		--dry-run|-n) dry_run=1; shift ;;
		--undo|-u) undo=1; shift ;;
		--force-undo) undo=1; force_undo=1; shift ;;
		--embargoed|-e) embargoed=1; shift ;;
		--help|-h) usage; exit 0 ;;
		-*) usage_error "Unknown option: $1" ;;
		*) args+=("$1"); shift ;;
	esac
done

if [[ ${#args[@]} -eq 0 ]]; then
	usage_error "At least one branch is required"
fi

typeset -A seen_arg
for b in "${args[@]}"; do
	if (( ${+seen_arg[$b]} )); then
		usage_error "Branch '$b' is given more than once"
	fi
	seen_arg[$b]=1
done

if ! git rev-parse --git-dir > /dev/null 2>&1; then
	echo "Error: Not in a git repository" >&2
	exit 1
fi
invoke_dir=$(git rev-parse --show-toplevel 2>/dev/null)
if [[ -z "$invoke_dir" ]]; then
	echo "Error: Must be run from a worktree (not a bare repository)" >&2
	exit 1
fi

# ---------------------------------------------------------------------------
# Main flow
# ---------------------------------------------------------------------------
(( undo )) && done_word="undone"
build_worktree_map

for b in "${args[@]}"; do
	add_branch "$b"
	if [[ $embargoed -eq 1 ]]; then
		add_branch "embargoed/frozen/$b"
		add_branch "embargoed/active/$b"
	fi
done

validate_local
fail_if_problems

if (( undo )); then
	plan_undo
	fail_if_problems
	print_undo_plan

	typeset -a undo_todo
	for b in "${all_branches[@]}"; do
		[[ "${u_state[$b]}" == restore ]] && undo_todo+=("$b")
	done
	if [[ ${#undo_todo[@]} -eq 0 ]]; then
		echo "Nothing to undo."
		exit 0
	fi
	if (( dry_run )); then
		echo "Dry run, nothing was undone."
		exit 0
	fi
	for b in "${undo_todo[@]}"; do
		if d=$(worktree_for_branch "$b"); then
			echo "Restoring $b in $d"
			git -C "$d" reset --hard --quiet "${u_old[$b]}" || { echo "Error: restore of $b failed" >&2; exit 1; }
		else
			echo "Restoring $b (not checked out, moving branch)"
			git branch --force "$b" "${u_old[$b]}" > /dev/null || { echo "Error: restore of $b failed" >&2; exit 1; }
		fi
	done
	echo ""
	n_skipped=$(( ${#all_branches[@]} - ${#undo_todo[@]} ))
	echo "Restored ${#undo_todo[@]} branch(es), $n_skipped skipped (no reset in the reflog, or already restored)."
	exit 0
fi

validate_remote_refs
fail_if_problems

evaluate
print_plan

typeset -a todo
for b in "${all_branches[@]}"; do
	[[ "${b_state[$b]}" != uptodate ]] && todo+=("$b")
done

if [[ ${#todo[@]} -eq 0 ]]; then
	echo "Everything is up to date, nothing to reset."
	exit 0
fi

if [[ $dry_run -eq 1 ]]; then
	echo "Dry run, nothing was reset."
	exit 0
fi

typeset -A discarded
bw=0
for b in "${todo[@]}"; do
	ref="refs/remotes/$(upstream_display $b)"
	if [[ "${b_state[$b]}" == ahead || "${b_state[$b]}" == diverged ]]; then
		discarded[$b]="${(j:, :)${(f)$(git rev-list --abbrev-commit "$ref..refs/heads/$b")}}"
		(( ${#b} > bw )) && bw=${#b}
	fi
	if d=$(worktree_for_branch "$b"); then
		echo "Resetting $b in $d"
		git -C "$d" reset --hard --quiet "$ref" || { echo "Error: reset of $b failed" >&2; exit 1; }
	else
		echo "Resetting $b (not checked out, moving branch)"
		git branch --force "$b" "$ref" > /dev/null || { echo "Error: reset of $b failed" >&2; exit 1; }
	fi
done

echo ""
echo "Reset ${#todo[@]} branch(es), $(( ${#all_branches[@]} - ${#todo[@]} )) already up to date."
if (( ${#discarded} )); then
	echo "Discarded commits (recover with 'git branch <name> <sha>', or run again with --undo):"
	for b in "${todo[@]}"; do
		(( ${+discarded[$b]} )) && printf "  %-${bw}s  %s\n" "$b" "${discarded[$b]}"
	done
fi
