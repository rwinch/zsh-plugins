#compdef git-worktrees-switch gwws

# The names of the feature branches that exist (feature/<branch>/NAME), without duplicates
_git-worktrees-switch-names() {
	local -a names
	names=(${${(f)"$(git for-each-ref --format='%(refname:short)' 'refs/heads/feature/' 2>/dev/null)"}##*/})
	names=(${(u)names})
	_describe -t names 'feature name' names
}

_arguments -s \
	'(-f --feature)'{-f,--feature}'[switch the worktrees onto feature/<branch>/NAME]:feature name:_git-worktrees-switch-names' \
	'--dry-run[show what would be switched without switching anything]' \
	'--help[display help message]' \
	'::feature name (switch back only that feature):_git-worktrees-switch-names'
