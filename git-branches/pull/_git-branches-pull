#compdef git-branches-pull gbbpl gbbpla

# Complete local branch names (git's own __git_branch_names is only available once _git has been loaded)
_zp_branches() {
	local -a branches
	branches=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)"})
	_wanted branches expl 'branch' compadd -a branches
}

_arguments -s -S \
	'(-n --dry-run)'{-n,--dry-run}'[fetch, validate and print what would happen, pull nothing]' \
	'(-e --embargoed)'{-e,--embargoed}'[arguments are OSS generations, also pull their embargoed branches]' \
	'(-h --help)'{-h,--help}'[display help message]' \
	'*:branch:_zp_branches'
