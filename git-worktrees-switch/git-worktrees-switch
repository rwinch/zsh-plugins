#!/bin/zsh

# Default values
feature=""
name=""
dry_run=0

usage() {
	cat <<EOF
Usage: git-worktrees-switch [--dry-run] [NAME]
       git-worktrees-switch [--dry-run] --feature NAME

Switch many worktrees at once between a branch and its feature branch
(feature/<branch>/NAME, the branches that git-branches-merge-forward --feature
makes).

Without --feature, every worktree that is on feature/<branch>/NAME is switched back
to <branch>. Without NAME, the feature branches of every name are switched back.

With --feature NAME, every worktree that is on a branch that is not a feature branch
is switched to feature/<branch>/NAME, when that branch exists.

OPTIONS:
  -f, --feature NAME   Switch the worktrees to feature/<branch>/NAME
  --dry-run            Show what would be switched without switching anything
  --help               Display this help message

BEHAVIOR:
  - Looks at every worktree of the repository, including the one you run it from
  - Leaves a worktree alone if it is detached or not on a matching branch
  - Skips a worktree, and exits with status 1 at the end, if it has changes
    (untracked files count), has a merge, rebase or cherry-pick in progress, or the
    branch to switch to is checked out in another worktree. Nothing is forced
  - Skips a worktree when the branch to switch to does not exist
  - FEATURE and NAME may not contain a '/'

EXAMPLES:
  git-worktrees-switch                # back from every feature branch
  git-worktrees-switch bug1           # back from the feature branches of bug1 only
  git-worktrees-switch --feature bug2 # onto the bug2 feature branches
  git-worktrees-switch --dry-run

REQUIREMENTS:
  - Must be run from within a git repository
EOF
}

# Parse arguments
while [[ $# -gt 0 ]]; do
	case $1 in
		-f|--feature)
			if [[ -z "$2" || "$2" == -* ]]; then
				echo "Error: $1 requires a value" >&2
				echo "" >&2
				usage >&2
				exit 1
			fi
			feature="$2"
			shift 2
			;;
		--dry-run)
			dry_run=1
			shift
			;;
		--help)
			usage
			exit 0
			;;
		-*)
			echo "Error: Unknown option: $1" >&2
			echo "" >&2
			usage >&2
			exit 1
			;;
		*)
			if [[ -n "$name" ]]; then
				echo "Error: Unexpected argument: $1" >&2
				echo "" >&2
				usage >&2
				exit 1
			fi
			name="$1"
			shift
			;;
	esac
done

if [[ -n "$feature" && -n "$name" ]]; then
	echo "Error: NAME and --feature cannot be used together" >&2
	echo "" >&2
	usage >&2
	exit 1
fi

if [[ "$feature" == */* || "$name" == */* ]]; then
	echo "Error: The feature name may not contain a '/'" >&2
	exit 1
fi

# Validate we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
	echo "Error: Not in a git repository" >&2
	exit 1
fi

# Worktrees are siblings of the current worktree, which is used to show their
# paths as ../name. For a slashed branch (release/1.0) the worktree lives deeper,
# so strip the current branch name from the root when it matches.
root=$(git rev-parse --show-toplevel)
cur=$(git symbolic-ref --short -q HEAD)
if [[ -n "$cur" && "$root" == */"$cur" ]]; then
	base="${root%/$cur}"
else
	base="${root:h}"
fi

show_path() {
	if [[ "$1" == "$base"/* ]]; then
		echo "../${1#$base/}"
	else
		echo "$1"
	fi
}

# Echoes why a worktree cannot be switched (changes, an operation in progress), if it cannot.
blocked_reason() {
	local dir="$1" gd f
	gd=$(git -C "$dir" rev-parse --absolute-git-dir 2>/dev/null)
	for f in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
		if [[ -n "$gd" && -e "$gd/$f" ]]; then
			case "$f" in
				MERGE_HEAD) echo "a merge is in progress" ;;
				CHERRY_PICK_HEAD) echo "a cherry-pick is in progress" ;;
				REVERT_HEAD) echo "a revert is in progress" ;;
				*) echo "a rebase is in progress" ;;
			esac
			return 0
		fi
	done
	if [[ -n "$(git -C "$dir" status --porcelain)" ]]; then
		echo "it has uncommitted changes"
	fi
}

# The worktrees on a branch: wt_paths[i] is on wt_branches[i] (detached worktrees are left out)
typeset -a wt_paths wt_branches
typeset -A checked_out
current_path=""
while IFS= read -r line; do
	case "$line" in
		"worktree "*) current_path="${line#worktree }" ;;
		"branch "*)
			ref="${line#branch refs/heads/}"
			wt_paths+=("$current_path")
			wt_branches+=("$ref")
			checked_out[$ref]="$current_path"
			;;
	esac
done < <(git worktree list --porcelain)

# Plan: the worktrees to switch, and why the others cannot be
typeset -a plan_paths plan_from plan_to
switched=0
skipped=0
failed=0

for (( i = 1; i <= ${#wt_paths}; i++ )); do
	dir="${wt_paths[$i]}"
	from="${wt_branches[$i]}"

	if [[ -n "$feature" ]]; then
		# onto the feature branch of every branch that is not a feature branch
		[[ "$from" == feature/* ]] && continue
		to="feature/$from/$feature"
	else
		# back to the branch of every feature branch (of NAME, if given)
		[[ "$from" == feature/*/* ]] || continue
		rest="${from#feature/}"
		[[ -z "$name" || "${rest##*/}" == "$name" ]] || continue
		to="${rest%/*}"
	fi

	if ! git show-ref --verify --quiet "refs/heads/$to"; then
		echo "Skipped $(show_path $dir) ($to does not exist)"
		(( skipped++ ))
		continue
	fi
	if [[ -n "${checked_out[$to]}" ]]; then
		echo "Skipped $(show_path $dir) ($to is checked out in $(show_path ${checked_out[$to]}))"
		(( skipped++ ))
		failed=1
		continue
	fi
	reason=$(blocked_reason "$dir")
	if [[ -n "$reason" ]]; then
		echo "Skipped $(show_path $dir) ($from: $reason)"
		(( skipped++ ))
		failed=1
		continue
	fi
	plan_paths+=("$dir")
	plan_from+=("$from")
	plan_to+=("$to")
done

if (( dry_run )); then
	if (( ${#plan_paths} )); then
		if [[ -n "$feature" ]]; then
			echo "Would switch to the feature branches of $feature:"
		else
			echo "Would switch back to the base branches:"
		fi
		for (( i = 1; i <= ${#plan_paths}; i++ )); do
			echo "  $(show_path ${plan_paths[$i]})  ${plan_from[$i]}  ->  ${plan_to[$i]}"
		done
	fi
	echo "Done: ${#plan_paths} would switch, $skipped skipped"
	exit $failed
fi

for (( i = 1; i <= ${#plan_paths}; i++ )); do
	if git -C "${plan_paths[$i]}" switch --quiet "${plan_to[$i]}"; then
		echo "Switched $(show_path ${plan_paths[$i]}) to ${plan_to[$i]}"
		(( switched++ ))
	else
		echo "Failed to switch $(show_path ${plan_paths[$i]}) to ${plan_to[$i]}" >&2
		(( skipped++ ))
		failed=1
	fi
done

if (( switched == 0 && skipped == 0 )); then
	echo "No worktrees to switch"
fi
echo "Done: $switched switched, $skipped skipped"
exit $failed
