#compdef git-branches-check-merged gbbcm gbbcma

_git_branches_check_merged_branches() {
	if (( $+functions[__git_branch_names] )); then
		__git_branch_names
	else
		local -a names
		names=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)"})
		_describe -t branches 'branch' names
	fi
}

_arguments -s \
	'(-l --local)'{-l,--local}'[check the local branches (the default)]' \
	'(-R --remote)'{-R,--remote}'[check the upstream branches as of the last fetch]' \
	'(-e --embargoed)'{-e,--embargoed}'[arguments are OSS generation branches, oldest to newest]' \
	'(-h --help)'{-h,--help}'[show this help message]' \
	'*:branch:_git_branches_check_merged_branches'
