#!/bin/zsh

# ---- options ----
check_local=0            # --local
check_remote=0           # --remote
disclosures=0            # --disclosures
releases_arg=""          # --releases V1,V2
releases_given=0
typeset -a branches      # positional args, in order

# ---- the plan: parallel arrays, one entry per hop ----
typeset -a hop_source
typeset -a hop_target
typeset -a hop_kind      # across | down (only for build_plan)

typeset -a rel_version
typeset -a rel_role      # frozen | active
typeset -a rel_gen       # <major>.<minor>
typeset -a rel_base      # disclosure branch the release is based on
typeset -a rel_note      # mapping note (main fallback)
typeset -a rel_will      # unused here, kept for the shared release parsing
typeset -a rel_lease     # unused here, kept for the shared release parsing

typeset -a all_branches  # every branch taking part, in plan order
typeset -A up_remote     # branch -> remote of its upstream
typeset -A up_branch     # branch -> branch name on that remote
typeset -a problems
checks_total=0
checks_bad=0
nl=$'\n'

usage() {
	cat <<USAGE
Usage: git-check-merged [OPTIONS] BRANCH1 [BRANCH2 ...]
       git-check-merged [OPTIONS] --disclosures GENERATION [GENERATION ...]
       git-check-merged [OPTIONS] --releases VERSION[,VERSION ...]

Check that a chain of branches is merged forward: BRANCH1 is contained in
BRANCH2, BRANCH2 in BRANCH3, ... The chain and the --disclosures and --releases
arguments are the same as for git-merge-forward, so the same arguments can be
used to merge and then to check.

Nothing is fetched and nothing is changed (run git fetch first to check what is
on the remote now). Worktrees may be dirty. The exit code is 0 when everything is
merged and 1 otherwise. Every problem is reported together: every branch exists
locally, and with --remote has an upstream that exists.

OPTIONS:
  --local, -l          Check the local branches (the default)
  --remote, -R         Check the upstream (remote tracking) branches, as of the
                       last fetch. Can be combined with --local.
  --disclosures, -d    The arguments are OSS generation branches, oldest to newest
                       (7.0.x 7.1.x main). Checks the same hops as
                       git-merge-forward --disclosures.
  --releases, -r LIST  Comma separated release versions, e.g. 7.0.1,7.0.1.1,7.1.0-RC1.
                       release/<version> must contain its base disclosure branch
                       (a hotfix version is based on disclosure/active/<major>.<minor>.x,
                       anything else on disclosure/frozen/<major>.<minor>.x).
  --help, -h           Display this help message

EXAMPLES:
  git-check-merged 7.0.x 7.1.x main
  git-check-merged --remote --disclosures 7.0.x main
  git-check-merged -l -R -d 7.0.x main -r 7.0.1.1

REQUIREMENTS:
  - Must be run from within a git repository
  - Every branch needs an upstream when --remote is used

USAGE
}

usage_error() {
	echo "Error: $1" >&2
	echo "Run 'git-check-merged --help' for usage." >&2
	exit 1
}

# ---------------------------------------------------------------------------
# Problem collection
# ---------------------------------------------------------------------------
problem() {
	problems+=("$1")
}

print_problem() {
	local p="$1" first=1 l
	for l in "${(@f)p}"; do
		if (( first )); then
			echo "  - $l" >&2
			first=0
		else
			echo "      $l" >&2
		fi
	done
}

fail_if_problems() {
	[[ ${#problems[@]} -eq 0 ]] && return 0
	local p
	echo "Error: ${#problems[@]} problem(s) found. Nothing was checked:" >&2
	for p in "${problems[@]}"; do
		print_problem "$p"
	done
	exit 1
}

branch_exists() {
	git show-ref --verify --quiet "refs/heads/$1"
}

add_branch() {
	(( ${all_branches[(Ie)$1]} )) || all_branches+=("$1")
}

# ---------------------------------------------------------------------------
# Plan
# ---------------------------------------------------------------------------
add_hop() {
	hop_source+=("$1")
	hop_target+=("$2")
	hop_kind+=("$3")
}

build_plan() {
	local i n
	if [[ $disclosures -eq 0 ]]; then
		for (( i = 2; i <= ${#branches[@]}; i++ )); do
			add_hop "${branches[$((i - 1))]}" "${branches[$i]}" across
		done
		return 0
	fi

	local -a gens
	gens=("${branches[@]}")
	n=${#gens[@]}
	local role
	for (( i = 2; i <= n; i++ )); do
		add_hop "${gens[$((i - 1))]}" "${gens[$i]}" across
	done
	for role in frozen active; do
		for (( i = 1; i <= n; i++ )); do
			if [[ "$role" == frozen ]]; then
				add_hop "${gens[$i]}" "disclosure/frozen/${gens[$i]}" down
			else
				add_hop "disclosure/frozen/${gens[$i]}" "disclosure/active/${gens[$i]}" down
			fi
			if (( i > 1 )); then
				add_hop "disclosure/$role/${gens[$((i - 1))]}" "disclosure/$role/${gens[$i]}" across
			fi
		done
	done
}

# Parses and checks --releases (no git needed).
parse_releases() {
	local -a items
	local v key
	local -A seen_version seen_base
	items=("${(@s:,:)releases_arg}")
	local major minor patch hotfix pre

	for v in "${items[@]}"; do
		if [[ ! "$v" =~ '^([0-9]+)\.([0-9]+)\.([0-9]+)(\.([0-9]+)|-(RC[0-9]+|M[0-9]+))?$' ]]; then
			usage_error "Invalid release version '$v' (expected <major>.<minor>.<patch>, optionally .<hotfix> or -RC<n> or -M<n>)"
		fi
		major="${match[1]}"; minor="${match[2]}"; patch="${match[3]}"; hotfix="${match[5]}"; pre="${match[6]}"
		if [[ -n "$pre" && "$patch" != 0 ]]; then
			usage_error "Invalid release version '$v' (an RC or M version must have patch 0)"
		fi
		if (( ${+seen_version[$v]} )); then
			usage_error "Release version '$v' is given more than once"
		fi
		seen_version[$v]=1
		local role=frozen
		[[ -n "$hotfix" ]] && role=active
		key="$role/$major.$minor"
		if (( ${+seen_base[$key]} )); then
			usage_error "Release versions '${seen_base[$key]}' and '$v' are both based on disclosure/$role/$major.$minor.x (at most one per base branch)"
		fi
		seen_base[$key]="$v"
		rel_version+=("$v")
		rel_role+=("$role")
		rel_gen+=("$major.$minor")
		rel_base+=("")
		rel_note+=("")
		rel_will+=(0)
		rel_lease+=("")
	done
}

# Maps every release to its base disclosure branch (needs the local branches).
map_release_bases() {
	local -a existing missing_gens
	local ref name i gen
	local -A exists_gen missing_versions

	while IFS= read -r ref; do
		if [[ "$ref" =~ '^disclosure/(frozen|active)/([0-9]+\.[0-9]+)\.x$' ]]; then
			exists_gen[${match[2]}]=1
		fi
	done < <(git for-each-ref --format='%(refname:short)' refs/heads/disclosure)

	for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
		gen="${rel_gen[$i]}"
		if (( ${+exists_gen[$gen]} )); then
			rel_base[$i]="disclosure/${rel_role[$i]}/$gen.x"
		else
			missing_versions[$gen]+="${missing_versions[$gen]:+, }${rel_version[$i]}"
			(( ${missing_gens[(Ie)$gen]} )) || missing_gens+=("$gen")
		fi
	done

	[[ ${#missing_gens[@]} -eq 0 ]] && return 0

	if [[ ${#exists_gen} -eq 0 ]]; then
		problem "No disclosure/*/<major>.<minor>.x branches exist locally, so releases ${(j:, :)${(v)missing_versions}} cannot be mapped"
		return 0
	fi

	local newest="" nmaj=-1 nmin=-1 g gmaj gmin
	for g in ${(k)exists_gen}; do
		gmaj=${g%%.*}; gmin=${g##*.}
		if (( gmaj > nmaj || (gmaj == nmaj && gmin > nmin) )); then
			nmaj=$gmaj; nmin=$gmin; newest="$g"
		fi
	done

	if [[ ${#missing_gens[@]} -gt 1 ]]; then
		for g in "${missing_gens[@]}"; do
			problem "Release(s) ${missing_versions[$g]}: no disclosure/*/$g.x branches, and several newer generations are given (${(j:, :)missing_gens}), so none can map to main"
		done
		return 0
	fi

	g="${missing_gens[1]}"
	local cand1="$nmaj.$((nmin + 1))" cand2="$((nmaj + 1)).0"
	if [[ "$g" != "$cand1" && "$g" != "$cand2" ]]; then
		problem "Release(s) ${missing_versions[$g]}: no disclosure/*/$g.x branches, and $g is not the generation after the newest existing one ($newest, next is $cand1 or $cand2), so it cannot map to main"
		return 0
	fi
	for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
		if [[ "${rel_gen[$i]}" == "$g" ]]; then
			rel_base[$i]="disclosure/${rel_role[$i]}/main"
			rel_note[$i]="no $g.x branch, newest generation"
		fi
	done
}

# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------
# Branches exist locally, and upstreams are set (needed by --remote and releases).
validate_local() {
	local b r m
	for b in "${all_branches[@]}"; do
		if ! branch_exists "$b"; then
			problem "$b: branch does not exist locally${nl}git branch --track $b <remote>/$b"
			continue
		fi
		r=$(git config "branch.$b.remote")
		m=$(git config "branch.$b.merge")
		if [[ -z "$r" || -z "$m" || "$r" == "." ]]; then
			(( check_remote )) && problem "$b: no upstream${nl}git branch --set-upstream-to=<remote>/$b $b"
			continue
		fi
		up_remote[$b]="$r"
		up_branch[$b]="${m#refs/heads/}"
	done
}

# Releases: a release branch must exist in every scope that is checked.
validate_release_refs() {
	local i rb rr
	for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
		rb="release/${rel_version[$i]}"
		if (( check_local )) && ! branch_exists "$rb"; then
			problem "$rb: branch does not exist locally${nl}git branch --track $rb <remote>/$rb"
		fi
		rr="${up_remote[${rel_base[$i]}]}"
		if (( check_remote )) && [[ -n "$rr" ]] && ! git show-ref --verify --quiet "refs/remotes/$rr/$rb"; then
			problem "$rb: '$rr/$rb' does not exist (run git fetch, this check does not fetch)"
		fi
	done
}

validate_remote_refs() {
	local b
	for b in "${all_branches[@]}"; do
		[[ -z "${up_remote[$b]}" ]] && continue
		if ! git show-ref --verify --quiet "refs/remotes/${up_remote[$b]}/${up_branch[$b]}"; then
			problem "$b: upstream '${up_remote[$b]}/${up_branch[$b]}' does not exist (run git fetch, this check does not fetch)"
		fi
	done
}

# ---------------------------------------------------------------------------
# Checking
# ---------------------------------------------------------------------------
# name_of SCOPE BRANCH: the name shown. ref_of SCOPE BRANCH: the full ref.
name_of() {
	[[ "$1" == local ]] && echo "$2" || echo "${up_remote[$2]}/${up_branch[$2]}"
}

ref_of() {
	[[ "$1" == local ]] && echo "refs/heads/$2" || echo "refs/remotes/${up_remote[$2]}/${up_branch[$2]}"
}

# report_pair SCOPE NAME-A NAME-B REF-A REF-B WIDTH-A WIDTH-B PREFIX ARROW
# merged when REF-A is contained in REF-B.
report_pair() {
	local label="$1" na="$2" nb="$3" ra="$4" rb="$5" wa="$6" wb="$7" prefix="$8" arrow="$9"
	local count line
	local -a lines
	(( checks_total++ ))
	if git merge-base --is-ancestor "$ra" "$rb"; then
		printf '  %s %-*s %s %-*s  merged\n' "$prefix" "$wa" "$na" "$arrow" "$wb" "$nb"
	else
		(( checks_bad++ ))
		count=$(git rev-list --count "$rb..$ra")
		printf '  %s %-*s %s %-*s  NOT MERGED, %d commit(s)\n' "$prefix" "$wa" "$na" "$arrow" "$wb" "$nb" "$count"
		echo "        git log --oneline $nb..$na"
		lines=("${(@f)$(git log --oneline -5 "$rb..$ra")}")
		for line in "${lines[@]}"; do echo "        $line"; done
		(( count > 5 )) && echo "        ..."
	fi
}

check_scope() {
	local scope="$1" i s t rb rr base wa=0 wb=0 n
	if [[ "$scope" == local ]]; then
		echo "Checking local branches:"
	else
		echo "Checking remote branches (no fetch, as of the last fetch):"
	fi

	for (( i = 1; i <= ${#hop_source[@]}; i++ )); do
		n=$(name_of $scope ${hop_source[$i]}); (( ${#n} > wa )) && wa=${#n}
		n=$(name_of $scope ${hop_target[$i]}); (( ${#n} > wb )) && wb=${#n}
	done
	for (( i = 1; i <= ${#hop_source[@]}; i++ )); do
		s="${hop_source[$i]}"; t="${hop_target[$i]}"
		report_pair "$scope" "$(name_of $scope $s)" "$(name_of $scope $t)" "$(ref_of $scope $s)" "$(ref_of $scope $t)" "$wa" "$wb" "($i)" "->"
	done

	if (( ${#rel_version[@]} > 0 )); then
		echo "Releases:"
		for (( i = 1; i <= ${#rel_version[@]}; i++ )); do
			base="${rel_base[$i]}"
			rb="release/${rel_version[$i]}"
			if [[ "$scope" == local ]]; then
				report_pair "$scope" "$rb" "$base" "refs/heads/$base" "refs/heads/$rb" 0 0 "" "contains"
			else
				rr="${up_remote[$base]}"
				report_pair "$scope" "$rr/$rb" "$rr/${up_branch[$base]}" "refs/remotes/$rr/${up_branch[$base]}" "refs/remotes/$rr/$rb" 0 0 "" "contains"
			fi
		done
	fi
	echo ""
}

# ---------------------------------------------------------------------------
# Parse arguments
# ---------------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
	case $1 in
		--local|-l) check_local=1; shift ;;
		--remote|-R) check_remote=1; shift ;;
		--disclosures|--disclosure|-d) disclosures=1; shift ;;
		--releases|-r)
			if [[ -z "$2" || "$2" == -* ]]; then
				usage_error "$1 requires a value (e.g. 7.0.1,7.0.1.1)"
			fi
			releases_arg="$2"
			releases_given=1
			shift 2
			;;
		--help|-h) usage; exit 0 ;;
		-*) usage_error "Unknown option: $1" ;;
		*) branches+=("$1"); shift ;;
	esac
done
(( check_local || check_remote )) || check_local=1

if [[ $disclosures -eq 1 ]]; then
	[[ ${#branches[@]} -ge 1 ]] || usage_error "--disclosures needs at least one generation branch"
elif [[ ${#branches[@]} -eq 0 ]]; then
	[[ $releases_given -eq 1 ]] || usage_error "At least two branches are required (or use --disclosures, or --releases alone)"
elif [[ ${#branches[@]} -eq 1 ]]; then
	usage_error "At least two branches are required (a single branch needs --disclosures)"
fi

typeset -A seen_arg
for b in "${branches[@]}"; do
	if (( ${+seen_arg[$b]} )); then
		usage_error "Branch '$b' is given more than once"
	fi
	seen_arg[$b]=1
done

[[ $releases_given -eq 1 ]] && parse_releases

if ! git rev-parse --git-dir > /dev/null 2>&1; then
	echo "Error: Not in a git repository" >&2
	exit 1
fi

# ---------------------------------------------------------------------------
# Main flow
# ---------------------------------------------------------------------------
build_plan
for (( i = 1; i <= ${#hop_source[@]}; i++ )); do
	add_branch "${hop_source[$i]}"
	add_branch "${hop_target[$i]}"
done

if [[ $releases_given -eq 1 ]]; then
	map_release_bases
	for (( i = 1; i <= ${#rel_base[@]}; i++ )); do
		[[ -n "${rel_base[$i]}" ]] && add_branch "${rel_base[$i]}"
	done
fi

validate_local
fail_if_problems
(( check_remote )) && validate_remote_refs
validate_release_refs
fail_if_problems

scopes=()
(( check_local )) && scopes+=(local)
(( check_remote )) && scopes+=(remote)
for scope in "${scopes[@]}"; do
	check_scope "$scope"
done

if (( checks_bad > 0 )); then
	echo "Error: $checks_bad of $checks_total check(s) not merged (${(j:, :)scopes})." >&2
	exit 1
fi
echo "All branches are merged properly (${(j:, :)scopes})."
