#compdef glno

# Complete local branch names (git's own __git_branch_names is only available once _git has been loaded)
_zp_branches() {
	local -a branches
	branches=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads refs/remotes 2>/dev/null)"})
	_wanted branches expl 'branch or range' compadd -a branches
}

_arguments -s \
	'(- *)'{-h,--help}'[display help message]' \
	'1:range:_zp_branches' \
	'*:git log option:_files'
