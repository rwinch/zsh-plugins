#!/bin/zsh

# ---- options ----
dry_run=0                # --dry-run
allow_ahead=0            # --allow-ahead
ours=0                   # --ours
embargoed=0              # --embargoed
pause_after_merge=0      # --pause
feature=""               # --feature
force=0                  # --force (with --feature)
fork_remote=""           # --fork-remote
typeset -a branches      # positional args, in order

# ---- worktree map, rebuilt by build_worktree_map ----
typeset -a wt_branches   # parallel array: branch name at index i
typeset -a wt_paths      # parallel array: worktree path at index i

# ---- the merge plan: parallel arrays, one entry per hop ----
typeset -a hop_source
typeset -a hop_target
typeset -a hop_kind      # across | down
typeset -a hop_noop      # 1 when source is already contained in target
typeset -a hop_would     # 1 when the hop would (or might) change target

typeset -a all_branches  # every branch taking part, in plan order
typeset -A up_remote     # branch -> remote of its upstream
typeset -A up_branch     # branch -> branch name on that remote
typeset -a problems
typeset -A changed       # branch -> 1 when an earlier hop would change it
typeset -A feat_of       # base branch -> its feature branch (--feature)
typeset -A feat_base     # feature branch -> its base branch
typeset -A twin_created  # feature branch -> 1 once it exists
start_existing=0         # 1 when the run starts on the first feature branch
typeset -A twin_existing  # base branch -> 1 when its feature branch exists and is reused

invoke_dir=""
original_ref=""
original_detached=0
chain_first=""
ab_behind=0
ab_ahead=0
nl=$'\n'

usage() {
	cat <<EOF
Usage: git-branches-merge-forward [OPTIONS] BRANCH1 [BRANCH2 ...]
       git-branches-merge-forward [OPTIONS] --embargoed GENERATION [GENERATION ...]
       git-branches-merge-forward [OPTIONS] --feature FEATURE BRANCH1 [BRANCH2 ...]
       git-branches-merge-forward [OPTIONS] --feature FEATURE --force BRANCH1 [BRANCH2 ...]

Merge a chain of branches forward: BRANCH1 -> BRANCH2 -> ... Each branch is
merged in the worktree that has it checked out, or in the directory you run
from when it is not checked out anywhere (that directory is switched back to
its original branch at the end). The current branch has no special role: the
arguments are the whole chain.

Everything is validated before anything changes, and all problems are reported
together: every branch exists locally, has an upstream, and has a clean
worktree (untracked files count); then every branch must match its upstream
as of the last fetch (nothing is fetched or pulled: run git-branches-fetch and
git-branches-pull first). The first branch may be ahead of its upstream (that is
what you merge forward), every other branch must be equal.
Nothing is pushed: the push commands are printed at the end.

OPTIONS:
  --dry-run, -n        Validate and print what would happen. Nothing is changed.
  --allow-ahead, -a    Let any branch in the chain be ahead of its upstream (behind
                       and diverged still fail). Useful when resuming an aborted
                       run, and when several branches carry their own unpushed
                       commits.
  --ours, -o           Record across hops with 'git merge -s ours' (nothing is
                       carried, so no conflicts). Down hops stay real merges.
                       Use it when each branch has its own version/dependency
                       updates that must not merge across.
  --embargoed, -e      The arguments are OSS generation branches, oldest to newest
                       (7.0.x 7.1.x main). Merges across, then for frozen and
                       active each embargoed/<role>/<generation> branch down
                       (OSS -> frozen -> active) and across.
  --feature, -f FEATURE
                       Leave the branches alone and merge feature branches instead:
                       feature/<branch>/FEATURE is created from each branch, and the
                       first one is only created. If you are already on the first
                       feature branch it is the start. Nothing is pushed; the push
                       commands (to your fork, or the upstream remote for embargoed
                       branches) are printed at the end.
  --force, -F          With --feature: reuse feature branches that already exist
                       (they are merged into as they are) instead of reporting them
                       as problems; missing ones are still created. 'git rerere' is
                       on for the merges, so a conflict resolved before is resolved
                       again by itself, for example after the first feature branch
                       was rebased. Feature branches have no upstream, so they are
                       not compared with one.
  --fork-remote REMOTE
                       The remote that gets the feature branches of non-embargoed
                       branches (default: your GitHub login, from 'gh api user')
  --pause, -P          After each merge, stop so the result can be
                       validated, and say which directory to do it in
  --help, -h           Display this help message

EXAMPLES:
  git-branches-merge-forward 7.0.x 7.1.x main
  git-branches-merge-forward --dry-run 7.0.x main
  git-branches-merge-forward --allow-ahead 7.0.x main        # resume after an abort
  git-branches-merge-forward --embargoed 7.0.x main
  git-branches-merge-forward -n -e 7.0.x main
  git-branches-merge-forward --feature bug1 7.0.x 7.1.x main
  git-branches-merge-forward --feature bug1 --force 7.0.x 7.1.x main   # the feature branches exist
  git-branches-merge-forward \$(svaob)   # svaob (spring-versions): the OSS branches on one line

DEPENDENCY UPDATES:
  If 7.0.x, 7.1.x and main each carry their own unpushed dependency updates
  that must not merge across, run:
    git-branches-merge-forward --ours --allow-ahead --embargoed 7.0.x 7.1.x main
  Across hops (OSS and embargoed) are recorded with 'git merge -s ours', and the
  down hops into each embargoed branch are real merges, so every generation
  keeps its own updates. --allow-ahead is needed because 7.1.x and main are ahead
  of their upstreams; drop it if those updates are already pushed.

REQUIREMENTS:
  - Must be run from within a git repository
  - Every branch needs an upstream (git branch --set-upstream-to=<remote>/<b> <b>)
  - Every worktree touched must be clean (no untracked files either)

EOF
}

usage_error() {
	echo "Error: $1" >&2
	echo "Run 'git-branches-merge-forward --help' for usage." >&2
	exit 1
}

# ---------------------------------------------------------------------------
# Problem collection
# ---------------------------------------------------------------------------
problem() {
	problems+=("$1")
}

print_problem() {
	local p="$1" first=1 l
	for l in "${(@f)p}"; do
		if (( first )); then
			echo "  - $l" >&2
			first=0
		else
			echo "      $l" >&2
		fi
	done
}

fail_if_problems() {
	[[ ${#problems[@]} -eq 0 ]] && return 0
	local p
	echo "Error: ${#problems[@]} problem(s) found. Nothing was merged:" >&2
	for p in "${problems[@]}"; do
		print_problem "$p"
	done
	exit 1
}

# ---------------------------------------------------------------------------
# Worktrees
# ---------------------------------------------------------------------------
build_worktree_map() {
	local current_path=""
	local line

	wt_branches=()
	wt_paths=()

	while IFS= read -r line; do
		case "$line" in
			"worktree "*)
				current_path="${line#worktree }"
				;;
			"branch "*)
				local ref="${line#branch }"
				wt_branches+=("${ref#refs/heads/}")
				wt_paths+=("$current_path")
				;;
			"")
				current_path=""
				;;
		esac
	done < <(git -C "$invoke_dir" worktree list --porcelain)
}

# Echoes the directory for a branch: its worktree if it is checked out
# somewhere, otherwise the directory the tool was run from.
resolve_dir_for_branch() {
	local branch="$1" i

	for (( i = 1; i <= ${#wt_branches[@]}; i++ )); do
		if [[ "${wt_branches[$i]}" == "$branch" ]]; then
			echo "${wt_paths[$i]}"
			return 0
		fi
	done
	echo "$invoke_dir"
}

is_branch_checked_out() {
	(( ${wt_branches[(Ie)$1]} ))
}

branch_exists() {
	git show-ref --verify --quiet "refs/heads/$1"
}

is_clean() {
	[[ -z "$(git -C "$1" status --porcelain)" ]]
}

# Echoes the name of an operation in progress in `dir` (merge, rebase, ...).
in_progress_state() {
	local dir="$1" gd f
	gd=$(git -C "$dir" rev-parse --absolute-git-dir 2>/dev/null) || return 1
	for f in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
		if [[ -e "$gd/$f" ]]; then
			case "$f" in
				MERGE_HEAD) echo "a merge is in progress (git -C \"$dir\" merge --abort, or commit it)" ;;
				CHERRY_PICK_HEAD) echo "a cherry-pick is in progress (git -C \"$dir\" cherry-pick --abort)" ;;
				REVERT_HEAD) echo "a revert is in progress (git -C \"$dir\" revert --abort)" ;;
				*) echo "a rebase is in progress (git -C \"$dir\" rebase --abort, or finish it)" ;;
			esac
			return 0
		fi
	done
	return 1
}

# Sets ab_behind/ab_ahead for `branch` against its upstream.
ahead_behind() {
	local branch="$1"
	local ref="refs/remotes/${up_remote[$branch]}/${up_branch[$branch]}"
	read ab_behind ab_ahead <<< "$(git rev-list --left-right --count "$ref...refs/heads/$branch")"
}

upstream_display() {
	echo "${up_remote[$1]}/${up_branch[$1]}"
}

add_branch() {
	(( ${all_branches[(Ie)$1]} )) || all_branches+=("$1")
}

# ---------------------------------------------------------------------------
# Feature branches (--feature): feature/<branch>/FEATURE for every branch
# ---------------------------------------------------------------------------
# The name a branch has in the plan: its feature branch with --feature.
plan_name() {
	if [[ -n "$feature" ]]; then
		echo "${feat_of[$1]}"
	else
		echo "$1"
	fi
}

# 1 when the feature branch of the base branch exists and is used as it is (the
# first one when the run starts on it, any with --force).
is_existing() {
	(( ${+twin_existing[$1]} ))
}

# The ref a branch is compared as: its existing feature branch (it holds the work),
# otherwise the branch itself.
eval_ref() {
	if is_existing "$1"; then
		echo "${feat_of[$1]}"
	else
		echo "$1"
	fi
}

# Why a feature branch cannot be created: it exists, or its name collides with an
# existing branch (git cannot have both feature/7.0.x and feature/7.0.x/bug1).
feature_conflict() {
	local twin="$1" prefix="" part
	local -a parts
	if branch_exists "$twin"; then
		echo "branch already exists"
		return 0
	fi
	parts=("${(@s:/:)twin}")
	for part in "${(@)parts[1,-2]}"; do
		prefix="${prefix:+$prefix/}$part"
		if branch_exists "$prefix"; then
			echo "'$prefix' is a branch, so it cannot also be a directory of branch names"
			return 0
		fi
	done
	if [[ -n "$(git for-each-ref --count=1 --format=x "refs/heads/$twin/")" ]]; then
		echo "existing branches live under '$twin/'"
		return 0
	fi
	return 1
}

is_embargoed_branch() {
	[[ "$1" == embargoed/* ]]
}

# The remote a feature branch is pushed to: the fork, or for an embargoed branch
# the upstream remote of its base branch.
feature_remote() {
	if is_embargoed_branch "$1"; then
		echo "${up_remote[$1]}"
	else
		echo "$fork_remote"
	fi
}

# Resolves the fork remote (needed when a non-embargoed feature branch is in the plan).
validate_fork_remote() {
	local b need=0
	for b in "${all_branches[@]}"; do
		is_embargoed_branch "$b" || need=1
	done
	(( need )) || return 0

	if [[ -z "$fork_remote" ]]; then
		if (( ! ${+commands[gh]} )); then
			problem "no remote for your fork: gh is not installed${nl}pass --fork-remote <remote>"
			return 0
		fi
		fork_remote=$(gh api user --jq .login 2>/dev/null)
		if [[ -z "$fork_remote" ]]; then
			problem "no remote for your fork: could not get your GitHub login from 'gh api user'${nl}pass --fork-remote <remote>"
			return 0
		fi
	fi
	if ! git remote get-url "$fork_remote" > /dev/null 2>&1; then
		problem "remote '$fork_remote' (your fork) does not exist${nl}git remote add $fork_remote <url of your fork>${nl}or: pass --fork-remote <remote>"
	fi
}

# ---------------------------------------------------------------------------
# Plan
# ---------------------------------------------------------------------------
add_hop() {
	hop_source+=("$1")
	hop_target+=("$2")
	hop_kind+=("$3")
}

build_plan() {
	local i n
	if [[ $embargoed -eq 0 ]]; then
		for (( i = 2; i <= ${#branches[@]}; i++ )); do
			add_hop "${branches[$((i - 1))]}" "${branches[$i]}" across
		done
		return 0
	fi

	local -a gens
	gens=("${branches[@]}")
	n=${#gens[@]}
	local role
	for (( i = 2; i <= n; i++ )); do
		add_hop "${gens[$((i - 1))]}" "${gens[$i]}" across
	done
	for role in frozen active; do
		for (( i = 1; i <= n; i++ )); do
			if [[ "$role" == frozen ]]; then
				add_hop "${gens[$i]}" "embargoed/frozen/${gens[$i]}" down
			else
				add_hop "embargoed/frozen/${gens[$i]}" "embargoed/active/${gens[$i]}" down
			fi
			if (( i > 1 )); then
				add_hop "embargoed/$role/${gens[$((i - 1))]}" "embargoed/$role/${gens[$i]}" across
			fi
		done
	done
}

# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------
check_dir() {
	local dir="$1" label="$2" st state count
	st=$(git -C "$dir" status --porcelain)
	if [[ -n "$st" ]]; then
		count=${#${(f)st}}
		problem "$label: working tree not clean, $count change(s) ($dir)"
	fi
	if state=$(in_progress_state "$dir"); then
		problem "$label: $state"
	fi
}

# Everything that needs no network: branches exist, worktrees clean, upstreams set.
validate_local() {
	local b d r m
	local -A dir_label

	for b in "${all_branches[@]}"; do
		if [[ -n "$feature" ]]; then
			if is_existing "$b"; then
				# the feature branch is used as it is: the directory it is (or will be) checked out in is touched
				if (( start_existing )) && [[ "$b" == "$chain_first" ]]; then
					d="$invoke_dir"
				else
					d=$(resolve_dir_for_branch "${feat_of[$b]}")
				fi
				dir_label[$d]="${dir_label[$d]:+${dir_label[$d]}, }${feat_of[$b]}"
				r=$(git config "branch.$b.remote")
				m=$(git config "branch.$b.merge")
				if [[ -n "$r" && -n "$m" && "$r" != "." ]]; then
					up_remote[$b]="$r"
					up_branch[$b]="${m#refs/heads/}"
				elif (( force )) && is_embargoed_branch "$b"; then
					problem "$b: no upstream, so the remote of ${feat_of[$b]} is not known${nl}git branch --set-upstream-to=<remote>/$b $b"
				fi
				continue
			fi
			if m=$(feature_conflict "${feat_of[$b]}"); then
				if [[ "$b" == "$chain_first" ]] && branch_exists "${feat_of[$b]}"; then
					m="$m (to start from it, check it out in $invoke_dir and run again, or use --force)"
				elif branch_exists "${feat_of[$b]}"; then
					m="$m (use --force to merge into it as it is)"
				fi
				problem "${feat_of[$b]}: $m"
			fi
		fi
		if ! branch_exists "$b"; then
			problem "$b: branch does not exist locally${nl}git branch $b <remote>/$b"
			continue
		fi
		d=$(resolve_dir_for_branch "$b")
		dir_label[$d]="${dir_label[$d]:+${dir_label[$d]}, }$b"

		r=$(git config "branch.$b.remote")
		m=$(git config "branch.$b.merge")
		if [[ -z "$r" || -z "$m" || "$r" == "." ]]; then
			problem "$b: no upstream${nl}git branch --set-upstream-to=<remote>/$b $b${nl}or: git push -u <remote> $b"
			continue
		fi
		up_remote[$b]="$r"
		up_branch[$b]="${m#refs/heads/}"
	done

	for d in ${(k)dir_label}; do
		check_dir "$d" "${dir_label[$d]}"
	done
}

# Upstream refs exist.
validate_remote_refs() {
	local b
	for b in "${all_branches[@]}"; do
		[[ -z "${up_remote[$b]}" ]] && continue
		is_existing "$b" && continue
		if ! git show-ref --verify --quiet "refs/remotes/${up_remote[$b]}/${up_branch[$b]}"; then
			problem "$b: upstream '$(upstream_display $b)' no longer exists on the remote (gone)${nl}git branch --set-upstream-to=<remote>/$b $b${nl}or: git push -u <remote> $b"
		fi
	done
}

# Every branch must match its upstream (the first may be ahead).
check_up_to_date() {
	local b allowed unpushed
	for b in "${all_branches[@]}"; do
		[[ -z "${up_remote[$b]}" ]] && continue
		is_existing "$b" && continue
		git show-ref --verify --quiet "refs/remotes/${up_remote[$b]}/${up_branch[$b]}" || continue
		ahead_behind "$b"
		[[ "$ab_behind" -eq 0 && "$ab_ahead" -eq 0 ]] && continue

		if [[ "$ab_behind" -gt 0 && "$ab_ahead" -gt 0 ]]; then
			problem "$b: diverged from $(upstream_display $b) ($ab_ahead ahead, $ab_behind behind), rebase or merge $(upstream_display $b) first"
		elif [[ "$ab_behind" -gt 0 ]]; then
			problem "$b: behind $(upstream_display $b) by $ab_behind commit(s) (run git-branches-pull)"
		else
			allowed=0
			[[ "$b" == "$chain_first" || $allow_ahead -eq 1 ]] && allowed=1
			if [[ $allowed -eq 0 ]]; then
				unpushed=$(git log --oneline -5 "refs/remotes/${up_remote[$b]}/${up_branch[$b]}..refs/heads/$b")
				problem "$b: ahead of $(upstream_display $b) by $ab_ahead commit(s), only the first branch may be ahead (see --allow-ahead)${nl}${unpushed}"
			fi
		fi
	done
}

# ---------------------------------------------------------------------------
# Plan evaluation and printing
# ---------------------------------------------------------------------------
evaluate_plan() {
	local i b
	changed=()
	for (( i = 1; i <= ${#hop_source[@]}; i++ )); do
		if git merge-base --is-ancestor "refs/heads/$(eval_ref "${hop_source[$i]}")" "refs/heads/$(eval_ref "${hop_target[$i]}")"; then
			hop_noop[$i]=1
		else
			hop_noop[$i]=0
		fi
		if [[ "${hop_noop[$i]}" -eq 0 || -n "${changed[${hop_source[$i]}]}" ]]; then
			hop_would[$i]=1
			changed[${hop_target[$i]}]=1
		else
			hop_would[$i]=0
		fi
	done
}

everything_noop() {
	local i
	for (( i = 1; i <= ${#hop_source[@]}; i++ )); do
		[[ "${hop_noop[$i]}" -eq 0 ]] && return 1
	done
	return 0
}

print_feature_branches() {
	local b w=0 twin
	for b in "${all_branches[@]}"; do
		(( ${#feat_of[$b]} > w )) && w=${#feat_of[$b]}
	done
	if (( force )); then
		echo "Feature branches (existing ones are reused, new ones are created from their base, no upstream until pushed):"
	else
		echo "Feature branches (created from their base, no upstream until pushed):"
	fi
	for b in "${all_branches[@]}"; do
		twin="${feat_of[$b]}"
		if (( start_existing )) && [[ "$b" == "$chain_first" ]]; then
			printf '  %-*s  already exists (current branch), used as the start\n' "$w" "$twin"
		elif is_existing "$b"; then
			printf '  %-*s  already exists, used as it is\n' "$w" "$twin"
		else
			printf '  %-*s  from %s\n' "$w" "$twin" "$b"
		fi
	done
	echo ""
}

print_plan() {
	local i ws=0 wt=0 wk=6 mode hop_status dir src tgt up_label=upstream
	[[ -n "$feature" ]] && up_label="base upstream"
	for (( i = 1; i <= ${#hop_source[@]}; i++ )); do
		src=$(plan_name "${hop_source[$i]}")
		tgt=$(plan_name "${hop_target[$i]}")
		(( ${#src} > ws )) && ws=${#src}
		(( ${#tgt} > wt )) && wt=${#tgt}
	done
	[[ -n "$feature" ]] && print_feature_branches

	if (( ${#hop_source[@]} > 0 )); then
		if (( force )); then
			echo "Plan (rerere is on, so conflict resolutions that were recorded are reused):"
		else
			echo "Plan:"
		fi
		for (( i = 1; i <= ${#hop_source[@]}; i++ )); do
			mode=merge
			[[ $ours -eq 1 && "${hop_kind[$i]}" == across ]] && mode=ours
			if [[ "${hop_would[$i]}" -eq 1 ]]; then hop_status="would merge"; else hop_status="up to date"; fi
			dir=$(resolve_dir_for_branch "${hop_target[$i]}")
			src=$(plan_name "${hop_source[$i]}")
			tgt=$(plan_name "${hop_target[$i]}")
			printf '  (%d) %-*s -> %-*s  %-*s %-5s %s\n' "$i" "$ws" "$src" "$wt" "$tgt" "$wk" "${hop_kind[$i]}" "$mode" "$hop_status"
			printf '        dir: %s   %s: %s\n' "$dir" "$up_label" "$(upstream_display "${hop_target[$i]}")"
		done
	fi
}

# One 'git push --atomic' per remote, remotes in plan order.
print_push_commands() {
	local -a remotes refs
	local b r i rb rr
	if [[ -n "$feature" ]]; then
		for b in "${all_branches[@]}"; do
			r=$(feature_remote "$b")
			(( ${remotes[(Ie)$r]} )) || remotes+=("$r")
		done
		for r in "${remotes[@]}"; do
			refs=()
			for b in "${all_branches[@]}"; do
				[[ "$(feature_remote "$b")" == "$r" ]] && refs+=("${feat_of[$b]}")
			done
			print -r -- "  git push --atomic -u $r \\"
			print -r -- "    ${refs[*]}"
		done
		return 0
	fi
	for b in "${all_branches[@]}"; do
		r="${up_remote[$b]}"
		(( ${remotes[(Ie)$r]} )) || remotes+=("$r")
	done

	for r in "${remotes[@]}"; do
		refs=()
		for b in "${all_branches[@]}"; do
			[[ "${up_remote[$b]}" == "$r" ]] || continue
			if [[ "$b" == "${up_branch[$b]}" ]]; then
				refs+=("$b")
			else
				refs+=("${b}:${up_branch[$b]}")
			fi
		done
		print -r -- "  git push --atomic $r \\"
		print -r -- "    ${refs[*]}"
	done
}

# ---------------------------------------------------------------------------
# Interactive helpers
# ---------------------------------------------------------------------------
read_tty() {
	local dir="$1"
	local response
	if ! read -r response </dev/tty; then
		echo "Error: No terminal available to prompt for input (dir: $dir)" >&2
		exit 1
	fi
	REPLY_TTY="$response"
}

prompt_retry() {
	local dir="$1"
	echo ""
	echo "Fix it in $dir, then:"
	echo "[Enter=retry / Ctrl+C=abort]"
	read_tty "$dir"
}

handle_conflict() {
	local dir="$1" source="$2" target="$3"

	echo ""
	echo "✗ Merge conflict merging '$source' into '$target'"
	echo ""
	echo "Resolve conflicts in: $dir"
	echo "Then run:"
	echo "  git -C \"$dir\" add <conflicted files>   (or: git -C \"$dir\" add -A)"
	echo "  git -C \"$dir\" commit --no-edit"
	echo ""

	while true; do
		echo "Resolved? [Enter=resume / f=force continue / Ctrl+C=abort]"
		read_tty "$dir"

		if [[ "$REPLY_TTY" == "f" || "$REPLY_TTY" == "F" ]]; then
			echo "⚠️  Force-continuing without validation..."
			return 0
		fi

		typeset -a conflict_problems
		conflict_problems=()

		if git -C "$dir" rev-parse -q --verify MERGE_HEAD > /dev/null 2>&1; then
			conflict_problems+=("MERGE_HEAD still present -- merge was not committed")
		fi

		local unmerged
		unmerged=$(git -C "$dir" diff --name-only --diff-filter=U)
		if [[ -n "$unmerged" ]]; then
			conflict_problems+=("Unmerged paths remain:")
			conflict_problems+=("${(f)unmerged}")
		fi

		if ! is_clean "$dir"; then
			conflict_problems+=("Working tree is not clean (uncommitted changes present)")
		fi

		if [[ ${#conflict_problems[@]} -eq 0 ]]; then
			echo "✓ Merge conflict resolved"
			return 0
		fi

		echo ""
		echo "Still not resolved:"
		local p
		for p in "${conflict_problems[@]}"; do
			echo "  - $p"
		done
		echo ""
	done
}

pause_for_validation() {
	local dir="$1" what="$2"

	echo ""
	echo "⏸  Paused after $what."
	echo "You can validate the result (e.g. build and run the tests) in: $dir"
	echo "[Enter=continue / Ctrl+C=abort]"
	read_tty "$dir"
}

# ---------------------------------------------------------------------------
# Merging
# ---------------------------------------------------------------------------
merge_branch() {
	local source="$1" target="$2" kind="$3" base_source="${4:-$1}" base_target="${5:-$2}"
	local dir current rc output resolved
	local msg_source="${base_source#embargoed/*/}" msg_target="${base_target#embargoed/*/}"
	local -a cmd

	while true; do
		build_worktree_map
		dir=$(resolve_dir_for_branch "$target")

		echo ""
		echo "Merging '$source' -> '$target' (dir: $dir)"

		current=$(git -C "$dir" rev-parse --abbrev-ref HEAD)
		if [[ "$current" != "$target" ]]; then
			echo "  → Checking out '$target' in $dir"
			if ! git -C "$dir" checkout "$target" > /dev/null; then
				echo "✗ Failed to check out '$target' in $dir" >&2
				prompt_retry "$dir"
				continue
			fi
		fi

		if [[ $ours -eq 1 && "$kind" == across ]]; then
			cmd=(git -C "$dir" merge -s ours --no-ff -m "merge(ours): $msg_source into $msg_target" "$source")
		elif [[ "$msg_source" != "$source" || "$msg_target" != "$target" ]]; then
			# embargoed branches read as their generation branches in history
			cmd=(git -C "$dir" merge --no-edit -m "Merge branch '$msg_source' into '$msg_target'" "$source")
		else
			cmd=(git -C "$dir" merge --no-edit "$source")
		fi

		resolved=0
		if (( force )); then
			# rerere reuses the conflict resolutions that were recorded before and stages them
			cmd=("${(@)cmd[1,3]}" -c rerere.enabled=true -c rerere.autoupdate=true "${(@)cmd[4,-1]}")
			output=$("${cmd[@]}" 2>&1)
			rc=$?
			print -r -- "$output"
			resolved=${#${(M)${(f)output}:#(Resolved|Staged) * using previous resolution*}}
		else
			"${cmd[@]}"
			rc=$?
		fi

		if git -C "$dir" rev-parse -q --verify MERGE_HEAD > /dev/null 2>&1; then
			if (( force )) && (( resolved )) && [[ -z "$(git -C "$dir" diff --name-only --diff-filter=U)" ]]; then
				echo "  rerere: reused a recorded resolution for $resolved file(s)"
				if git -C "$dir" -c rerere.enabled=true commit --no-edit > /dev/null; then
					echo "✓ Merged '$source' into '$target' (dir: $dir), resolved with rerere"
					if [[ $pause_after_merge -eq 1 ]]; then
						pause_for_validation "$dir" "merging '$source' into '$target'"
					fi
					return 0
				fi
				echo "✗ Could not commit the merge of '$source' into '$target'" >&2
				prompt_retry "$dir"
				continue
			fi
			(( force )) && (( resolved )) && echo "  rerere: reused a recorded resolution for $resolved file(s), the rest is yours"
			handle_conflict "$dir" "$source" "$target"
			break
		fi
		if [[ $rc -ne 0 ]]; then
			echo "✗ Merge of '$source' into '$target' failed (not a conflict)" >&2
			prompt_retry "$dir"
			continue
		fi
		break
	done

	echo "✓ Merged '$source' into '$target' (dir: $dir)"

	if [[ $pause_after_merge -eq 1 ]]; then
		pause_for_validation "$dir" "merging '$source' into '$target'"
	fi
}

# Creates the feature branch of `base` (no upstream) in the directory of `base`.
create_feature_branch() {
	local base="$1" twin="${feat_of[$1]}" dir
	(( ${+twin_created[$twin]} )) && return 0

	while true; do
		build_worktree_map
		dir=$(resolve_dir_for_branch "$base")
		echo ""
		echo "Creating '$twin' from '$base' (dir: $dir)"
		if git -C "$dir" checkout --quiet -b "$twin" --no-track "$base"; then
			break
		fi
		echo "✗ Failed to create '$twin' in $dir" >&2
		prompt_retry "$dir"
	done
	twin_created[$twin]=1
	echo "✓ Created '$twin' from '$base' (dir: $dir)"
}

# After a run: the worktrees (other than the one you ran from) that were left on a feature branch.
print_feature_summary() {
	local b i dirs=0
	local -a created
	for b in "${all_branches[@]}"; do
		is_existing "$b" && continue
		created+=("${feat_of[$b]}")
	done
	if (( ${#created[@]} )); then
		echo "Created: ${(j:, :)created}"
	fi

	build_worktree_map
	for b in "${all_branches[@]}"; do
		for (( i = 1; i <= ${#wt_branches[@]}; i++ )); do
			[[ "${wt_branches[$i]}" == "${feat_of[$b]}" && "${wt_paths[$i]}" != "$invoke_dir" ]] || continue
			(( dirs )) || echo "Worktrees left on a feature branch:"
			dirs=1
			echo "  ${wt_paths[$i]} is on ${feat_of[$b]} (git -C \"${wt_paths[$i]}\" switch $b to go back)"
		done
	done
}

on_abort() {
	echo "" >&2
	echo "Aborted. The directory $invoke_dir was started on '$original_ref' (not restored)." >&2
	exit 130
}

restore_original_branch() {
	local current
	current=$(git -C "$invoke_dir" rev-parse --abbrev-ref HEAD)
	if [[ $original_detached -eq 1 ]]; then
		[[ "$(git -C "$invoke_dir" rev-parse HEAD)" == "$original_ref" ]] && return 0
		git -C "$invoke_dir" checkout --detach --quiet "$original_ref" || echo "⚠️  Could not restore $invoke_dir to $original_ref" >&2
	else
		[[ "$current" == "$original_ref" ]] && return 0
		if git -C "$invoke_dir" checkout --quiet "$original_ref"; then
			echo "Restored '$original_ref' in $invoke_dir"
		else
			echo "⚠️  Could not restore '$original_ref' in $invoke_dir" >&2
		fi
	fi
}

# ---------------------------------------------------------------------------
# Parse arguments
# ---------------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
	case $1 in
		--dry-run|-n) dry_run=1; shift ;;
		--allow-ahead|-a) allow_ahead=1; shift ;;
		--ours|-o) ours=1; shift ;;
		--embargoed|-e) embargoed=1; shift ;;
		--pause|-P) pause_after_merge=1; shift ;;
		--force|-F) force=1; shift ;;
		--feature|-f)
			[[ $# -ge 2 && -n "$2" && "$2" != -* ]] || usage_error "$1 needs a FEATURE name"
			feature="$2"; shift 2 ;;
		--feature=*) feature="${1#--feature=}"; [[ -n "$feature" ]] || usage_error "--feature needs a FEATURE name"; shift ;;
		--fork-remote)
			[[ $# -ge 2 && -n "$2" && "$2" != -* ]] || usage_error "--fork-remote needs a remote name"
			fork_remote="$2"; shift 2 ;;
		--help|-h) usage; exit 0 ;;
		-*) usage_error "Unknown option: $1" ;;
		*) branches+=("$1"); shift ;;
	esac
done

# ---------------------------------------------------------------------------
# Argument checks (no git yet)
# ---------------------------------------------------------------------------
if [[ $embargoed -eq 1 ]]; then
	[[ ${#branches[@]} -ge 1 ]] || usage_error "--embargoed needs at least one generation branch"
elif [[ ${#branches[@]} -eq 0 ]]; then
	usage_error "At least two branches are required (or use --embargoed)"
elif [[ ${#branches[@]} -eq 1 ]]; then
	usage_error "At least two branches are required (a single branch needs --embargoed)"
fi

if [[ -n "$feature" ]]; then
	[[ "$feature" != */* ]] || usage_error "The FEATURE name must not contain '/' (got '$feature')"
	git check-ref-format --branch "feature/x/$feature" > /dev/null 2>&1 || usage_error "'$feature' is not a valid branch name part"
elif [[ -n "$fork_remote" ]]; then
	usage_error "--fork-remote only applies with --feature"
elif (( force )); then
	usage_error "--force only applies with --feature"
fi

typeset -A seen_arg
for b in "${branches[@]}"; do
	if (( ${+seen_arg[$b]} )); then
		usage_error "Branch '$b' is given more than once"
	fi
	seen_arg[$b]=1
done

if ! git rev-parse --git-dir > /dev/null 2>&1; then
	echo "Error: Not in a git repository" >&2
	exit 1
fi

# ---------------------------------------------------------------------------
# Main flow
# ---------------------------------------------------------------------------
invoke_dir=$(git rev-parse --show-toplevel 2>/dev/null)
if [[ -z "$invoke_dir" ]]; then
	echo "Error: Must be run from a worktree (not a bare repository)" >&2
	exit 1
fi
original_ref=$(git -C "$invoke_dir" rev-parse --abbrev-ref HEAD)
if [[ "$original_ref" == "HEAD" ]]; then
	original_detached=1
	original_ref=$(git -C "$invoke_dir" rev-parse HEAD)
fi

build_worktree_map

build_plan
for (( i = 1; i <= ${#hop_source[@]}; i++ )); do
	add_branch "${hop_source[$i]}"
	add_branch "${hop_target[$i]}"
done
[[ ${#branches[@]} -gt 0 ]] && chain_first="${branches[1]}"

if [[ -n "$feature" ]]; then
	for b in "${all_branches[@]}"; do
		feat_of[$b]="feature/$b/$feature"
		feat_base[${feat_of[$b]}]="$b"
	done
	# already on the first feature branch: it is the start, nothing is created for it
	if [[ $original_detached -eq 0 && "$original_ref" == "${feat_of[$chain_first]}" ]]; then
		start_existing=1
		twin_existing[$chain_first]=1
		twin_created[${feat_of[$chain_first]}]=1
	fi
	# --force: every other feature branch that exists is used as it is
	if (( force )); then
		for b in "${all_branches[@]}"; do
			branch_exists "${feat_of[$b]}" || continue
			twin_existing[$b]=1
			twin_created[${feat_of[$b]}]=1
		done
	fi
fi

# 1. Local validation: exist, upstream, clean.
validate_local
fail_if_problems

# 2. Remote refs: upstreams exist.
validate_remote_refs
[[ -n "$feature" ]] && validate_fork_remote
fail_if_problems

# 3. Every branch must match its upstream.
check_up_to_date
fail_if_problems

# 4. Nothing to do?
evaluate_plan
if everything_noop; then
	echo "Everything is up to date, nothing to merge."
	exit 0
fi

print_plan

if [[ $dry_run -eq 1 ]]; then
	echo ""
	echo "Dry run: nothing was changed. At the end it would print:"
	print_push_commands
	exit 0
fi

# 5. Merge.
trap on_abort INT
echo ""
echo "Starting: ${#hop_source[@]} merge(s)"

for (( i = 1; i <= ${#hop_source[@]}; i++ )); do
	if [[ -n "$feature" ]]; then
		create_feature_branch "${hop_source[$i]}"
		create_feature_branch "${hop_target[$i]}"
		merge_branch "$(plan_name "${hop_source[$i]}")" "$(plan_name "${hop_target[$i]}")" "${hop_kind[$i]}" "${hop_source[$i]}" "${hop_target[$i]}"
	else
		merge_branch "${hop_source[$i]}" "${hop_target[$i]}" "${hop_kind[$i]}"
	fi
done

trap - INT

# 6. Finish.
echo ""
echo "Done! Merged ${#hop_source[@]} hop(s)."
build_worktree_map
restore_original_branch
if [[ -n "$feature" ]]; then
	print_feature_summary
fi

echo ""
echo "Nothing has been pushed. To publish, run:"
print_push_commands
